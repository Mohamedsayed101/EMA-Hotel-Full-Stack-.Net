@{
    ViewData["Title"] = "Sign In";
}

<div class="bg-surface font-body-md text-on-surface antialiased min-h-screen flex flex-col justify-center items-center">


    <main class="w-full flex items-center justify-center">

        <div class="flex flex-col w-full">

            <div class="relative w-full py-12 md:py-20 flex items-center justify-center overflow-hidden">

                <!-- Background Decorations -->
                <div class="absolute inset-0 -z-10 overflow-hidden pointer-events-none">
                    <div class="absolute -top-32 -left-32 w-96 h-96 rounded-full bg-primary/10 blur-3xl"></div>
                    <div class="absolute top-1/2 right-0 w-[30rem] h-[30rem] rounded-full bg-tertiary/10 blur-3xl"></div>
                    <div class="absolute -bottom-24 left-1/3 w-80 h-80 rounded-full bg-primary-fixed-dim/15 blur-2xl"></div>
                </div>

                <div class="w-full max-w-5xl px-4 md:px-8 grid grid-cols-1 lg:grid-cols-12 gap-0 overflow-hidden rounded-xl shadow-xl bg-surface-container-lowest">

                    <!-- LEFT SIDE -->
                    <div class="lg:col-span-7 p-8 md:p-12 lg:p-14 flex flex-col justify-between">

                        <div>

                            <!-- Logo + Header -->
                            <div class="flex flex-col items-center text-center mb-8">

                                <div class="h-12 w-auto mb-5 flex items-center justify-center">

                                    <img alt="EMA Hotel Luxury Suites & Resort"
                                         class="h-10 md:h-12 object-contain"
                                         src="https://lh3.googleusercontent.com/aida/AEtjO1ULIW39iFbgMyTL6BD9O2AbzZfahdgH8VdGcVr0nvTZ4GeWgccfKB9F-vTLbMxz2SKMnzMquZuX5WWigS59TF0weqSKz938VVQpRE1fq8KpK4mEn7xpDw75eooXfjmoKvW57461990fX9aBMJcRCBX7XiXVfpinPyTafVW6DZE8X0Yms4NwRFESyx42ELLbI2AGomGTF6pM2ExBzywmYAFdRttq7rDkLKZVO0Gkv8mgumLfa5EMRBvg60U" />

                                </div>

                                <div class="inline-flex items-center gap-2 px-3 py-1 mb-4 rounded-full bg-surface-container text-tertiary">

                                    <span class="material-symbols-outlined text-base">
                                        verified_user
                                    </span>

                                    <span class="font-label-caps text-label-caps uppercase tracking-wider">
                                        Member Sanctuary Portal
                                    </span>

                                </div>

                                <h1 class="font-headline-md text-headline-md text-on-surface tracking-tight">
                                    Welcome Back to EMA Hotel
                                </h1>

                                <p class="font-body-md text-body-md text-on-surface-variant mt-2.5 max-w-md">
                                    Sign in to manage your reservations, access exclusive member rates, and unlock tailored concierge services.
                                </p>

                            </div>

                            <!-- LOGIN FORM -->
                            <form asp-controller="Account"
                                  asp-action="Login"
                                  asp-route-returnurl="@Context.Request.Query["returnUrl"]"
                                  method="post"
                                  class="space-y-5"
                                  onsubmit="return handleFormSubmit(event)">

                                  <input type="hidden" name="ReturnUrl" value="@Context.Request.Query["returnUrl"]" />
                                @if (!ViewData.ModelState.IsValid)
                                {
                                    <div asp-validation-summary="All" class="mb-2 p-4 rounded-xl bg-red-50 border border-red-200 text-red-700 text-sm space-y-1"></div>
                                }

                                <div class="space-y-1.5">

                                    <label class="block font-label-md text-label-md text-on-surface"
                                           for="Input_Email">
                                        Email Address
                                    </label>

                                    <div class="relative flex items-center">

                                        <span class="material-symbols-outlined absolute left-3.5 text-outline text-xl pointer-events-none">
                                            mail
                                        </span>

                                        <input autocomplete="email"
                                               autofocus
                                               class="w-full h-12 pl-11 pr-4 bg-surface-container-low text-on-surface placeholder:text-outline font-body-md text-body-md rounded-lg focus:bg-surface-container-lowest focus:outline-none transition-all duration-200"
                                               id="Input_Email"
                                               name="Email"
                                               placeholder="name@example.com"
                                               required
                                               type="email" />

                                    </div>

                                </div>

                                <div class="space-y-1.5">

                                    <div class="flex items-center justify-between">

                                        <label class="block font-label-md text-label-md text-on-surface"
                                               for="Input_Password">
                                            Password
                                        </label>

                                    </div>

                                    <div class="relative flex items-center">

                                        <span class="material-symbols-outlined absolute left-3.5 text-outline text-xl pointer-events-none">
                                            lock
                                        </span>

                                        <input autocomplete="current-password"
                                               class="w-full h-12 pl-11 pr-11 bg-surface-container-low text-on-surface placeholder:text-outline font-body-md text-body-md rounded-lg focus:bg-surface-container-lowest focus:outline-none transition-all duration-200"
                                               id="Input_Password"
                                               name="Password"
                                               placeholder="••••••••••••"
                                               required
                                               type="password" />

                                        <button aria-label="Toggle password visibility"
                                                class="absolute right-3.5 text-outline hover:text-primary transition-colors focus:outline-none"
                                                id="togglePasswordBtn"
                                                onclick="togglePasswordVisibility()"
                                                type="button">

                                            <span class="material-symbols-outlined text-xl"
                                                  id="pwdEyeIcon">
                                                visibility
                                            </span>

                                        </button>

                                    </div>

                                </div>

                                <!-- Remember + Forgot -->
                                <div class="flex items-center justify-between pt-1">

                                    <label class="inline-flex items-center gap-2.5 cursor-pointer select-none">

                                        <input class="sr-only peer"
                                               id="Input_RememberMe"
                                               name="RememberMe"
                                               type="checkbox"
                                               value="true" />

                                        <div class="w-4 h-4 rounded-sm bg-surface-container flex items-center justify-center text-on-primary transition-all duration-150 peer-checked:bg-primary">

                                            <span class="material-symbols-outlined text-sm font-bold opacity-0 peer-checked:opacity-100">
                                                check
                                            </span>

                                        </div>

                                        <span class="font-body-sm text-body-sm text-on-surface-variant">
                                            Remember this device
                                        </span>

                                    </label>

                                    <a asp-controller="Account"
                                       asp-action="ForgotPassword"
                                       class="font-label-md text-label-md text-primary hover:text-on-primary-fixed-variant transition-colors underline-offset-4 hover:underline">

                                        Forgot password?

                                    </a>

                                </div>

                                <!-- Sign In -->
                                <button class="w-full h-12 bg-primary hover:bg-primary-container text-on-primary font-label-md text-label-md rounded-lg shadow-md hover:shadow-lg transition-all duration-200 flex items-center justify-center gap-2 cursor-pointer mt-2"
                                        id="signInBtn"
                                        type="submit">

                                    <span>
                                        Sign In to Your Suite
                                    </span>

                                    <span class="material-symbols-outlined text-lg">
                                        arrow_forward
                                    </span>

                                </button>

                            </form>

                            <!-- Divider -->
                            <div class="relative my-7 flex items-center justify-center">

                                <div class="w-full h-px bg-surface-container-high"></div>

                                <span class="absolute bg-surface-container-lowest px-4 font-label-caps text-label-caps uppercase text-secondary">
                                    Or continue with
                                </span>

                            </div>

                            <!-- Social Login -->
                            <div class="grid grid-cols-2 gap-3">

                                <!-- Google -->
                                <a asp-controller="Account"
                                   asp-action="ExternalLogin"
                                   asp-route-provider="Google"
                                   asp-route-returnUrl="@Context.Request.Query["returnUrl"]"
                                   class="h-11 px-4 rounded-lg bg-surface-container-low hover:bg-surface-container flex items-center justify-center gap-2.5 transition-all duration-150 text-on-surface">

                                    <svg class="w-4 h-4"
                                         viewBox="0 0 24 24">

                                        <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
                                              fill="#4285F4">
                                        </path>

                                        <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
                                              fill="#34A853">
                                        </path>

                                        <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"
                                              fill="#FBBC05">
                                        </path>

                                        <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"
                                              fill="#EA4335">
                                        </path>

                                    </svg>

                                    <span class="font-label-md text-label-md">
                                        Google
                                    </span>

                                </a>

                                <!-- Apple -->
                                <a class="h-11 px-4 rounded-lg bg-surface-container-low hover:bg-surface-container flex items-center justify-center gap-2.5 transition-all duration-150 text-on-surface"
                                   href="#">

                                    <svg class="w-4 h-4 fill-current"
                                         viewBox="0 0 24 24">

                                        <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.38c.62-.75 1.04-1.8.93-2.85-.9.04-1.99.6-2.64 1.35-.58.66-1.09 1.73-.95 2.76 1.01.08 2.05-.51 2.66-1.26z">
                                        </path>

                                    </svg>

                                    <span class="font-label-md text-label-md">
                                        Apple
                                    </span>

                                </a>

                            </div>

                        </div>

                        <!-- Register -->
                        <div class="mt-8 pt-6 flex flex-col items-center text-center gap-3">

                            <p class="font-body-sm text-body-sm text-on-surface-variant">

                                Don't have a curated account yet?

                                <a asp-controller="Account"
                                   asp-action="Register"
                                   class="text-primary hover:text-on-primary-fixed-variant font-medium underline underline-offset-4 ml-1">

                                    Register

                                </a>

                            </p>

                            <div class="inline-flex items-center gap-1.5 text-secondary font-label-caps text-label-caps">

                                <span class="material-symbols-outlined text-sm">
                                    lock
                                </span>

                                <span>
                                    Secured with 256-bit encryption • Member Privacy Guaranteed
                                </span>

                            </div>

                        </div>

                    </div>

                    <!-- RIGHT SIDE -->
                    <div class="hidden lg:flex lg:col-span-5 relative bg-surface-container overflow-hidden flex-col justify-between p-10">

                        <div class="absolute inset-0 bg-cover bg-center"
                             data-alt="Intimate sunlit interior of a high-end luxury resort suite in warm golden tones, displaying fine linen draped bed, limestone architectural elements, tailored walnut millwork, brushed champagne brass fixtures, and serene warm natural lighting reminiscent of tranquil boutique hospitality."
                             style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuCFYVJFZfN5nI35ucaN7SpEZr6-b5aWY_hjAALMfNDD6eK3yviovo-SvHV15WJGh5XALi1mqSxXeu7F8DKQJuDRa9IiqdXlgAQl1TbFezjSAizQQ-n2Fv7AoN-7myRG32aIUBNKc8RrqxQaVgp5cjgjoXmV5glZdhe5263CCLDMJIQdlXFvLZ0hXCdAmafRodD4qvtk8aDnfvvThIRD6tkQUHXDU3FK2JWdiTfaFzyKx4mbnxtxQIzU')">
                        </div>

                        <div class="absolute inset-0 bg-gradient-to-t from-inverse-surface/90 via-inverse-surface/40 to-transparent">
                        </div>

                        <!-- Concierge Badge -->
                        <div class="relative z-10 flex justify-end">

                            <div class="inline-flex items-center gap-1.5 bg-surface-container-lowest/80 backdrop-blur-md px-3 py-1 rounded-full text-on-surface font-label-caps text-label-caps shadow-sm">

                                <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>

                                <span>
                                    Live Concierge Active
                                </span>

                            </div>

                        </div>

                        <!-- Quote -->
                        <div class="relative z-10 text-on-primary space-y-4">

                            <div class="flex items-center gap-1 text-tertiary-fixed">

                                @for (int i = 0; i < 5; i++)
                                {
                                    <span class="material-symbols-outlined text-lg"
                                          style="font-variation-settings: 'FILL' 1;">
                                        star
                                    </span>
                                }

                            </div>

                            <blockquote class="font-headline-sm text-headline-sm italic leading-snug">

                                "Every stay is an unhurried composition of silence, refined comfort, and deeply intuitive care."

                            </blockquote>

                            <div class="pt-2 flex items-center justify-between">

                                <div>

                                    <p class="font-label-md text-label-md text-on-primary font-semibold">
                                        The Grand Penthouse & Spa
                                    </p>

                                    <p class="font-body-sm text-body-sm text-outline-variant">
                                        EMA Hotel Dolomites Residence
                                    </p>

                                </div>

                                <div class="text-right">

                                    <span class="font-label-caps text-label-caps uppercase text-primary-fixed block">
                                        Member Rate
                                    </span>

                                    <span class="font-headline-sm text-headline-sm text-on-primary">
                                        $1,240
                                    </span>

                                    <span class="font-body-sm text-body-sm text-outline-variant">
                                        /night
                                    </span>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </main>


</div>

@section Scripts {


    <script>

        function togglePasswordVisibility() {

            const input =
                document.getElementById('Input_Password');

            const icon =
                document.getElementById('pwdEyeIcon');

            if (input.type === 'password') {

                input.type = 'text';

                icon.textContent = 'visibility_off';

            } else {

                input.type = 'password';

                icon.textContent = 'visibility';

            }
        }


        function handleFormSubmit(e) {

            const btn =
                document.getElementById('signInBtn');

            btn.classList.add(
                'opacity-80',
                'pointer-events-none'
            );

            btn.innerHTML = `
                    <span class="material-symbols-outlined animate-spin text-lg">
                        progress_activity
                    </span>
                    <span>
                        Authenticating Stay...
                    </span>
                `;

            return true;
        }

    </script>

}

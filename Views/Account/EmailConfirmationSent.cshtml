@{
    ViewData["Title"] = "Email Confirmation";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="min-h-[70vh] flex items-center justify-center px-6 py-16">
    <div class="max-w-lg w-full text-center">

        <div class="mx-auto mb-6 flex h-20 w-20 items-center justify-center rounded-full bg-[#b08d57]/10">
            <span class="material-symbols-outlined text-5xl text-[#b08d57]">
                mark_email_read
            </span>
        </div>

        <h1 class="text-3xl font-serif font-semibold text-gray-900 mb-4">
            Check Your Email
        </h1>

        <p class="text-gray-600 leading-7 mb-6">
            Thank you for joining EMA Hotel.
            We've sent a confirmation link to your email address.
        </p>

        <p class="text-sm text-gray-500 mb-8">
            Please check your inbox and click the confirmation link
            to activate your account.
        </p>

        <a asp-controller="Account"
           asp-action="Login"
           class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-lg bg-[#b08d57] text-white hover:opacity-90 transition">
            Continue to Sign In
            <span class="material-symbols-outlined text-lg">
                arrow_forward
            </span>
        </a>

    </div>
</div>
@model Hotel_MVC.ViewModels.AccountVM.ForgotPasswordVM

@{
    ViewData["Title"] = "Forgot Password";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="min-h-[70vh] flex items-center justify-center px-6 py-16">
    <div class="max-w-lg w-full">

        <div class="text-center mb-8">
            <div class="mx-auto mb-6 flex h-20 w-20 items-center justify-center rounded-full bg-[#b08d57]/10">
                <span class="material-symbols-outlined text-5xl text-[#b08d57]">
                    lock_reset
                </span>
            </div>

            <h1 class="text-3xl font-serif font-semibold text-gray-900 mb-3">
                Forgot Your Password?
            </h1>

            <p class="text-gray-600 leading-7">
                Enter your email address and we'll send you a link
                to reset your password.
            </p>
        </div>

        <form asp-action="ForgotPassword" method="post" class="space-y-5">

            <div>
                <label asp-for="Email"
                       class="block text-sm font-medium text-gray-700 mb-2">
                    Email Address
                </label>

                <input asp-for="Email"
                       type="email"
                       autocomplete="email"
                       placeholder="you@example.com"
                       class="w-full h-12 px-4 rounded-lg border border-gray-300 focus:border-[#b08d57] focus:ring-1 focus:ring-[#b08d57] outline-none transition" />

                <span asp-validation-for="Email"
                      class="text-sm text-red-600">
                </span>
            </div>

            <div asp-validation-summary="ModelOnly"
                 class="text-sm text-red-600">
            </div>

            <button type="submit"
                    class="w-full h-12 rounded-lg bg-[#b08d57] text-white font-medium hover:opacity-90 transition flex items-center justify-center gap-2">
                Send Reset Link
                <span class="material-symbols-outlined text-lg">
                    arrow_forward
                </span>
            </button>

        </form>

        <div class="text-center mt-6">
            <a asp-action="Login"
               class="text-sm text-gray-600 hover:text-[#b08d57] transition">
                ← Back to Sign In
            </a>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
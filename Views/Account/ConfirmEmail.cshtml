@model Hotel_MVC.ViewModels.AccountVM.ConfirmEmailVM

@{
    ViewData["Title"] = "Confirm Email";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="min-h-[70vh] flex items-center justify-center px-6 py-16">
    <div class="max-w-lg w-full text-center">

        <div class="mx-auto mb-6 flex h-20 w-20 items-center justify-center rounded-full bg-[#b08d57]/10">
            <span class="material-symbols-outlined text-5xl text-[#b08d57]">
                verified
            </span>
        </div>

        <h1 class="text-3xl font-serif font-semibold text-gray-900 mb-4">
            Confirm Your Email
        </h1>

        <p class="text-gray-600 leading-7 mb-8">
            Please click the button below to confirm your email address
            and activate your EMA Hotel account.
        </p>

        <form asp-action="ConfirmEmail" method="post">

            <input type="hidden" asp-for="UserId" />
            <input type="hidden" asp-for="Token" />

            <button type="submit"
                    class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-lg bg-[#b08d57] text-white hover:opacity-90 transition">
                Confirm Email
                <span class="material-symbols-outlined text-lg">
                    verified
                </span>
            </button>

            <div asp-validation-summary="ModelOnly"
                 class="mt-4 text-red-600 text-sm">
            </div>

        </form>

    </div>
</div>
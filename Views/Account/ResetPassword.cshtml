@model Hotel_MVC.ViewModels.AccountVM.ResetPasswordVM

@{
    ViewData["Title"] = "Reset Password";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="min-h-[70vh] flex items-center justify-center px-6 py-16">
    <div class="max-w-lg w-full">

        <!-- Header -->
        <div class="text-center mb-8">

            <div class="mx-auto mb-6 flex h-20 w-20 items-center justify-center rounded-full bg-[#b08d57]/10">
                <span class="material-symbols-outlined text-5xl text-[#b08d57]">
                    lock_reset
                </span>
            </div>

            <h1 class="text-3xl font-serif font-semibold text-gray-900 mb-3">
                Reset Your Password
            </h1>

            <p class="text-gray-600 leading-7">
                Enter your new password below.
            </p>

        </div>

        <!-- Form -->
        <form asp-action="ResetPassword"
              method="post"
              class="space-y-5">

            <input asp-for="Email" type="hidden" />

            <input asp-for="Token" type="hidden" />

            <!-- New Password -->
            <div>

                <label asp-for="NewPassword"
                       class="block text-sm font-medium text-gray-700 mb-2">
                    New Password
                </label>

                <input asp-for="NewPassword"
                       type="password"
                       autocomplete="new-password"
                       placeholder="Enter your new password"
                       class="w-full h-12 px-4 rounded-lg border border-gray-300 focus:border-[#b08d57] focus:ring-1 focus:ring-[#b08d57] outline-none transition" />

                <span asp-validation-for="NewPassword"
                      class="text-sm text-red-600">
                </span>

            </div>

            <!-- Confirm Password -->
            <div>

                <label asp-for="ConfirmPassword"
                       class="block text-sm font-medium text-gray-700 mb-2">
                    Confirm New Password
                </label>

                <input asp-for="ConfirmPassword"
                       type="password"
                       autocomplete="new-password"
                       placeholder="Confirm your new password"
                       class="w-full h-12 px-4 rounded-lg border border-gray-300 focus:border-[#b08d57] focus:ring-1 focus:ring-[#b08d57] outline-none transition" />

                <span asp-validation-for="ConfirmPassword"
                      class="text-sm text-red-600">
                </span>

            </div>

            <!-- Validation Summary -->
            <div asp-validation-summary="ModelOnly"
                 class="text-sm text-red-600">
            </div>

            <!-- Submit -->
            <button type="submit"
                    class="w-full h-12 rounded-lg bg-[#b08d57] text-white font-medium hover:opacity-90 transition flex items-center justify-center gap-2">

                Reset Password

                <span class="material-symbols-outlined text-lg">
                    lock_reset
                </span>

            </button>

        </form>

        <!-- Back -->
        <div class="text-center mt-6">

            <a asp-action="Login"
               class="text-sm text-gray-600 hover:text-[#b08d57] transition">
                ← Back to Sign In
            </a>

        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
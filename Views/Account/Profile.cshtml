
@model Hotel_MVC.ViewModels.AccountVM.ProfileVM

@{
    ViewData["Title"] = "Guest Profile & Preferences";
}

<div class="w-full bg-[#f8f6f2] min-h-screen">

    <!-- =========================================================
         HERO
    ========================================================== -->
    <section class="w-full px-6 lg:px-margin pt-10 pb-8">
        <div class="max-w-[1320px] mx-auto">

            <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6">
                
                <div>

                    <p class="text-xs uppercase tracking-[0.25em] text-[#b08d57] font-semibold mb-3">
                        Guest Portal
                    </p>

                    <h1 class="font-serif text-4xl md:text-5xl text-[#241d17]">
                        Your Profile
                    </h1>

                    <p class="mt-3 text-stone-500 max-w-2xl">
                        Manage your personal information, security,
                        preferences and stay details.
                    </p>

                </div>

                <div class="text-sm text-stone-500">

                    Membership ID

                    <span class="font-semibold text-[#241d17]">
                        #EMA-MEM-4091
                    </span>

                </div>

            </div>

        </div>
    </section>


    <!-- =========================================================
         SUCCESS MESSAGE
    ========================================================== -->
    @if (TempData["SuccessMessage"] != null)
    {
        <section class="w-full px-6 lg:px-margin pb-6">

            <div class="max-w-[1320px] mx-auto">

                <div class="rounded-xl border border-emerald-200 bg-emerald-50 px-5 py-4 text-emerald-800 text-sm font-medium">

                    @TempData["SuccessMessage"]

                </div>

            </div>

        </section>
    }


    <!-- =========================================================
         ERROR MESSAGE
    ========================================================== -->
    @if (TempData["ErrorMessage"] != null)
    {
        <section class="w-full px-6 lg:px-margin pb-6">

            <div class="max-w-[1320px] mx-auto">

                <div class="rounded-xl border border-red-200 bg-red-50 px-5 py-4 text-red-800 text-sm font-medium">

                    @TempData["ErrorMessage"]

                </div>

            </div>

        </section>
    }


    <!-- =========================================================
         MAIN CONTENT
    ========================================================== -->
    <section class="w-full px-6 lg:px-margin pb-16">

        <div class="max-w-[1320px] mx-auto">

            <div class="grid grid-cols-1 lg:grid-cols-[320px_1fr] gap-8">


                <!-- =================================================
                     SIDEBAR
                ================================================== -->
                <aside class="space-y-6">


                    <!-- =================================================
                         PROFILE CARD
                    ================================================== -->
                    <div class="bg-white rounded-2xl border border-stone-200 shadow-sm overflow-hidden">

                        <div class="h-28 bg-[#241d17] relative">

                            <div class="absolute -bottom-14 left-1/2 -translate-x-1/2">

                                <div class="w-28 h-28 rounded-full border-4 border-white bg-stone-100 overflow-hidden shadow-md">


                                    <!-- ===============================
                                         CURRENT PROFILE IMAGE
                                    ================================ -->
                                    @if (!string.IsNullOrWhiteSpace(Model.ProfileImagePath))
                                    {
                                        <img src="@Model.ProfileImagePath"
                                             alt="Profile photo"
                                             id="profileImage"
                                             class="w-full h-full object-cover cursor-pointer transition-transform duration-300 hover:scale-105"
                                             onclick="openProfileImage()" />
                                    }


                                    <!-- ===============================
                                         INITIALS
                                    ================================ -->
                                    <div id="profile-initials"
                                         class="@(string.IsNullOrWhiteSpace(Model.ProfileImagePath)
                                             ? "flex"
                                             : "hidden")
                                         w-full h-full items-center justify-center
                                         bg-[#e8dfd2]
                                         text-[#6f5a40]
                                         text-3xl font-semibold">

                                        @(
                                            string.IsNullOrWhiteSpace(Model.FirstName)
                                                ? "G"
                                                : Model.FirstName.Substring(0, 1).ToUpper()
                                        )

                                    </div>


                                    <!-- ===============================
                                         PREVIEW IMAGE
                                    ================================ -->
                                    <img id="profile-image-preview"
                                         src=""
                                         alt="Profile photo preview"
                                         class="hidden w-full h-full object-cover" />

                                </div>

                            </div>

                        </div>


                        <div class="pt-20 pb-7 px-6 text-center">

                            <h2 class="font-serif text-2xl text-[#241d17]">

                                @Model.FirstName @Model.LastName

                            </h2>


                            <p class="text-sm text-stone-500 mt-1 break-all">

                                @Model.Email

                            </p>


                            <div class="mt-4 inline-flex items-center gap-2 rounded-full bg-[#f4eee5] px-4 py-2 text-xs font-semibold text-[#8b6b3d]">

                                <span class="material-symbols-outlined text-base">
                                    workspace_premium
                                </span>

                                Preferred Member

                            </div>


                            <!-- =================================================
                                 PROFILE PHOTO UPLOAD
                            ================================================== -->
                            <div class="mt-6 pt-6 border-t border-stone-200">

                                <form asp-controller="Account"
                                      asp-action="ChangeProfileImage"
                                      method="post"
                                      enctype="multipart/form-data"
                                      id="profile-image-form">

                                    @Html.AntiForgeryToken()


                                    <input type="file"
                                           asp-for="ProfileImage"
                                           id="profile-image-input"
                                           accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                                           class="hidden" />


                                    <!-- Change Photo -->

                                    <button type="button"
                                            id="change-profile-photo"
                                            class="w-full rounded-xl border border-stone-300 px-4 py-3 text-sm font-semibold text-stone-700 hover:bg-stone-50 transition">

                                        <span class="material-symbols-outlined align-middle text-base mr-1">
                                            photo_camera
                                        </span>

                                        Change Profile Photo

                                    </button>


                                    <!-- Selected File -->

                                    <div id="selected-photo-info"
                                         class="hidden mt-4 rounded-xl bg-[#f8f3eb] border border-[#eadcc8] p-4 text-left">

                                        <div class="flex items-start gap-3">

                                            <span class="material-symbols-outlined text-[#b08d57]">
                                                image
                                            </span>

                                            <div class="min-w-0 flex-1">

                                                <p class="text-sm font-semibold text-[#241d17]">
                                                    Selected photo
                                                </p>

                                                <p id="selected-photo-name"
                                                   class="text-xs text-stone-500 mt-1 break-all">
                                                </p>

                                                <p id="selected-photo-size"
                                                   class="text-xs text-stone-400 mt-1">
                                                </p>

                                            </div>

                                        </div>

                                    </div>


                                    <!-- Validation Message -->

                                    <p id="photo-validation-message"
                                       class="hidden text-xs text-red-600 mt-2 text-left">
                                    </p>


                                    <!-- Upload -->

                                    <button type="submit"
                                            id="upload-profile-photo"
                                            class="hidden w-full mt-3 rounded-xl bg-[#b08d57] px-4 py-3 text-sm font-semibold text-white hover:bg-[#9a7849] transition">

                                        <span class="material-symbols-outlined align-middle text-base mr-1">
                                            upload
                                        </span>

                                        Upload Photo

                                    </button>


                                    <!-- Cancel -->

                                    <button type="button"
                                            id="cancel-photo-selection"
                                            class="hidden w-full mt-2 rounded-xl border border-stone-300 px-4 py-2.5 text-sm text-stone-600 hover:bg-stone-50 transition">

                                        Cancel

                                    </button>


                                    <p class="text-[11px] leading-5 text-stone-400 mt-3">

                                        JPG, JPEG, PNG or WEBP · Maximum 5 MB

                                    </p>

                                </form>

                            </div>

                        </div>

                    </div>


                    <!-- =================================================
                         MEMBERSHIP CARD
                    ================================================== -->
                    <div class="bg-[#241d17] rounded-2xl p-6 text-white shadow-sm">

                        <div class="flex items-center justify-between mb-6">

                            <div>

                                <p class="text-xs uppercase tracking-[0.2em] text-[#cdb58e]">
                                    EMA Circle
                                </p>

                                <h3 class="font-serif text-xl mt-1">
                                    Preferred Member
                                </h3>

                            </div>

                            <span class="material-symbols-outlined text-[#cdb58e]">
                                diamond
                            </span>

                        </div>


                        <div class="grid grid-cols-2 gap-4">

                            <div>

                                <p class="text-xs text-stone-400">
                                    Stays
                                </p>

                                <p class="text-xl font-semibold mt-1">
                                    11
                                </p>

                            </div>


                            <div>

                                <p class="text-xs text-stone-400">
                                    Points
                                </p>

                                <p class="text-xl font-semibold mt-1">
                                    48,500
                                </p>

                            </div>

                        </div>

                    </div>


                    <!-- =================================================
                         NAVIGATION
                    ================================================== -->
                    <div class="bg-white rounded-2xl border border-stone-200 shadow-sm p-3">

                        <a href="#personal-details"
                           class="flex items-center gap-3 rounded-xl px-4 py-3 text-sm text-stone-700 hover:bg-[#f8f3eb] hover:text-[#8b6b3d] transition">

                            <span class="material-symbols-outlined">
                                person
                            </span>

                            Personal Details

                        </a>


                        <a href="#security"
                           class="flex items-center gap-3 rounded-xl px-4 py-3 text-sm text-stone-700 hover:bg-[#f8f3eb] hover:text-[#8b6b3d] transition">

                            <span class="material-symbols-outlined">
                                lock
                            </span>

                            Security & Password

                        </a>


                        <a href="#preferences"
                           class="flex items-center gap-3 rounded-xl px-4 py-3 text-sm text-stone-700 hover:bg-[#f8f3eb] hover:text-[#8b6b3d] transition">

                            <span class="material-symbols-outlined">
                                tune
                            </span>

                            Stay Preferences

                        </a>


                        <a href="#payment-methods"
                           class="flex items-center gap-3 rounded-xl px-4 py-3 text-sm text-stone-700 hover:bg-[#f8f3eb] hover:text-[#8b6b3d] transition">

                            <span class="material-symbols-outlined">
                                credit_card
                            </span>

                            Payment Methods

                        </a>


                        <div class="border-t border-stone-200 my-3"></div>


                        <form asp-controller="Account"
                              asp-action="Logout"
                              method="post">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="w-full flex items-center gap-3 rounded-xl px-4 py-3 text-sm text-red-600 hover:bg-red-50 transition">

                                <span class="material-symbols-outlined">
                                    logout
                                </span>

                                Sign Out

                            </button>

                        </form>

                    </div>

                </aside>


                <!-- =================================================
                     MAIN CONTENT
                ================================================== -->
                <main class="space-y-8">


                    <!-- =================================================
                         PERSONAL DETAILS
                    ================================================== -->
                    <section id="personal-details"
                             class="bg-white rounded-2xl border border-stone-200 shadow-sm p-6 md:p-8">

                        <div class="mb-8">

                            <p class="text-xs uppercase tracking-[0.2em] text-[#b08d57] font-semibold">
                                Personal Information
                            </p>

                            <h2 class="font-serif text-3xl text-[#241d17] mt-2">
                                Your Details
                            </h2>

                            <p class="text-sm text-stone-500 mt-2">
                                Keep your contact information up to date.
                            </p>

                        </div>


                        <form asp-controller="Account"
                              asp-action="Profile"
                              method="post"
                              class="space-y-6"
                              id="personal-info-form">

                            @Html.AntiForgeryToken()


                            <div asp-validation-summary="ModelOnly"
                                 class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
                            </div>


                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">


                                <!-- First Name -->

                                <div>

                                    <label asp-for="FirstName"
                                           class="block text-sm font-medium text-stone-700 mb-2">
                                        First Name
                                    </label>

                                    <input asp-for="FirstName"
                                           class="w-full rounded-xl border border-stone-300 bg-white px-4 py-3 text-stone-800 outline-none transition focus:border-[#b08d57] focus:ring-2 focus:ring-[#b08d57]/20" />

                                    <span asp-validation-for="FirstName"
                                          class="text-sm text-red-600">
                                    </span>

                                </div>


                                <!-- Last Name -->

                                <div>

                                    <label asp-for="LastName"
                                           class="block text-sm font-medium text-stone-700 mb-2">
                                        Last Name
                                    </label>

                                    <input asp-for="LastName"
                                           class="w-full rounded-xl border border-stone-300 bg-white px-4 py-3 text-stone-800 outline-none transition focus:border-[#b08d57] focus:ring-2 focus:ring-[#b08d57]/20" />

                                    <span asp-validation-for="LastName"
                                          class="text-sm text-red-600">
                                    </span>

                                </div>


                                <!-- Email -->

                                <div>

                                    <label asp-for="Email"
                                           class="block text-sm font-medium text-stone-700 mb-2">
                                        Email Address
                                    </label>

                                    <input asp-for="Email"
                                           readonly
                                           class="w-full rounded-xl border border-stone-200 bg-stone-50 px-4 py-3 text-stone-500 cursor-not-allowed" />

                                    <p class="text-xs text-stone-400 mt-2">
                                        Email address cannot be changed from this page.
                                    </p>

                                </div>


                                <!-- Phone -->

                                <div>

                                    <label asp-for="PhoneNumber"
                                           class="block text-sm font-medium text-stone-700 mb-2">
                                        Phone Number
                                    </label>

                                    <input asp-for="PhoneNumber"
                                           class="w-full rounded-xl border border-stone-300 bg-white px-4 py-3 text-stone-800 outline-none transition focus:border-[#b08d57] focus:ring-2 focus:ring-[#b08d57]/20" />

                                    <span asp-validation-for="PhoneNumber"
                                          class="text-sm text-red-600">
                                    </span>

                                </div>


                                <!-- Nationality -->

                                <div>

                                    <label asp-for="Nationality"
                                           class="block text-sm font-medium text-stone-700 mb-2">
                                        Nationality
                                    </label>

                                    <select asp-for="Nationality"
                                            class="w-full rounded-xl border border-stone-300 bg-white px-4 py-3 text-stone-800 outline-none transition focus:border-[#b08d57] focus:ring-2 focus:ring-[#b08d57]/20">

                                        <option value="">
                                            Select nationality
                                        </option>

                                        <option value="Egyptian">
                                            Egyptian
                                        </option>

                                        <option value="American">
                                            American
                                        </option>

                                        <option value="British">
                                            British
                                        </option>

                                        <option value="Canadian">
                                            Canadian
                                        </option>

                                        <option value="French">
                                            French
                                        </option>

                                        <option value="Swiss">
                                            Swiss
                                        </option>

                                        <option value="Japanese">
                                            Japanese
                                        </option>

                                        <option value="Other">
                                            Other
                                        </option>

                                    </select>

                                </div>


                                <!-- Passport -->

                                <div>

                                    <label asp-for="PassportOrNationalId"
                                           class="block text-sm font-medium text-stone-700 mb-2">
                                        Passport / National ID
                                    </label>

                                    <input asp-for="PassportOrNationalId"
                                           readonly
                                           class="w-full rounded-xl border border-stone-200 bg-stone-50 px-4 py-3 text-stone-500 cursor-not-allowed" />

                                    <p class="text-xs text-stone-400 mt-2">
                                        This information is managed securely by the hotel.
                                    </p>

                                </div>

                            </div>


                            <div class="flex flex-col sm:flex-row justify-end gap-3 pt-4 border-t border-stone-200">

                                <button type="button"
                                        id="discard-personal"
                                        class="rounded-xl border border-stone-300 px-6 py-3 text-sm font-semibold text-stone-700 hover:bg-stone-50 transition">

                                    Discard Changes

                                </button>


                                <button type="submit"
                                        class="rounded-xl bg-[#b08d57] px-6 py-3 text-sm font-semibold text-white hover:bg-[#9a7849] transition">

                                    Save Changes

                                </button>

                            </div>

                        </form>

                    </section>


                    <!-- =================================================
                         SECURITY
                    ================================================== -->
                    <section id="security"
                             class="bg-white rounded-2xl border border-stone-200 shadow-sm p-6 md:p-8">

                        <div class="mb-8">

                            <p class="text-xs uppercase tracking-[0.2em] text-[#b08d57] font-semibold">
                                Account Security
                            </p>

                            <h2 class="font-serif text-3xl text-[#241d17] mt-2">
                                Security & Password
                            </h2>

                            <p class="text-sm text-stone-500 mt-2">
                                Change your password securely using your current password.
                            </p>

                        </div>


                        <form asp-controller="Account"
                              asp-action="ChangePassword"
                              method="post"
                              class="space-y-6"
                              id="password-form"
                              autocomplete="off">

                            @Html.AntiForgeryToken()


                            <div asp-validation-summary="ModelOnly"
                                 class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
                            </div>


                            <!-- Current Password -->

                            <div>

                                <label asp-for="CurrentPassword"
                                       class="block text-sm font-medium text-stone-700 mb-2">
                                    Current Password
                                </label>

                                <div class="relative">

                                    <input asp-for="CurrentPassword"
                                           type="password"
                                           id="CurrentPassword"
                                           value=""
                                           autocomplete="current-password"
                                           class="w-full rounded-xl border border-[#d8cec0] bg-white px-4 py-3 pr-12 text-sm text-[#241d17] outline-none transition focus:border-[#b08a57] focus:ring-2 focus:ring-[#b08a57]/20"
                                           placeholder="Enter your current password" />

                                    <button type="button"
                                            onclick="togglePasswordVisibility('CurrentPassword', this)"
                                            class="absolute right-3 top-1/2 -translate-y-1/2 text-stone-500 hover:text-[#8b6b3d]">

                                        <span class="material-symbols-outlined">
                                            visibility
                                        </span>

                                    </button>

                                </div>

                                <span asp-validation-for="CurrentPassword"
                                      class="text-sm text-red-600">
                                </span>

                            </div>


                            <!-- New Password -->

                            <div>

                                <label asp-for="NewPassword"
                                       class="block text-sm font-medium text-stone-700 mb-2">
                                    New Password
                                </label>

                                <div class="relative">

                                    <input asp-for="NewPassword"
                                           type="password"
                                           id="NewPassword"
                                           autocomplete="new-password"
                                           class="w-full rounded-xl border border-[#d8cec0] bg-white px-4 py-3 pr-12 text-sm text-[#241d17] outline-none transition focus:border-[#b08a57] focus:ring-2 focus:ring-[#b08a57]/20"
                                           placeholder="Enter your new password" />

                                    <button type="button"
                                            onclick="togglePasswordVisibility('NewPassword', this)"
                                            class="absolute right-3 top-1/2 -translate-y-1/2 text-stone-500 hover:text-[#8b6b3d]">

                                        <span class="material-symbols-outlined">
                                            visibility
                                        </span>

                                    </button>

                                </div>

                                <span asp-validation-for="NewPassword"
                                      class="text-sm text-red-600">
                                </span>

                            </div>


                            <!-- Confirm Password -->

                            <div>

                                <label asp-for="ConfirmNewPassword"
                                       class="block text-sm font-medium text-stone-700 mb-2">
                                    Confirm New Password
                                </label>

                                <div class="relative">

                                    <input asp-for="ConfirmNewPassword"
                                           type="password"
                                           id="ConfirmNewPassword"
                                           autocomplete="new-password"
                                           class="w-full rounded-xl border border-[#d8cec0] bg-white px-4 py-3 pr-12 text-sm text-[#241d17] outline-none transition focus:border-[#b08a57] focus:ring-2 focus:ring-[#b08a57]/20"
                                           placeholder="Confirm your new password" />

                                    <button type="button"
                                            onclick="togglePasswordVisibility('ConfirmNewPassword', this)"
                                            class="absolute right-3 top-1/2 -translate-y-1/2 text-stone-500 hover:text-[#8b6b3d]">

                                        <span class="material-symbols-outlined">
                                            visibility
                                        </span>

                                    </button>

                                </div>

                                <span asp-validation-for="ConfirmNewPassword"
                                      class="text-sm text-red-600">
                                </span>

                            </div>


                            <div class="rounded-xl bg-[#f8f3eb] border border-[#eadcc8] p-4">

                                <div class="flex gap-3">

                                    <span class="material-symbols-outlined text-[#b08d57]">
                                        info
                                    </span>

                                    <div>

                                        <p class="text-sm font-semibold text-[#241d17]">
                                            Password security
                                        </p>

                                        <p class="text-xs text-stone-500 mt-1">
                                            Your new password must satisfy the security
                                            requirements configured for your EMA Hotel account.
                                        </p>

                                    </div>

                                </div>

                            </div>


                            <div class="flex justify-end pt-4 border-t border-stone-200">

                                <button type="submit"
                                        class="rounded-xl bg-[#b08d57] px-6 py-3 text-sm font-semibold text-white hover:bg-[#9a7849] transition">

                                    Update Password

                                </button>

                            </div>

                        </form>

                    </section>


                    <!-- =================================================
                         STAY PREFERENCES
                    ================================================== -->
                    <section id="preferences"
                             class="bg-white rounded-2xl border border-stone-200 shadow-sm p-6 md:p-8">

                        <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4 mb-8">

                            <div>

                                <p class="text-xs uppercase tracking-[0.2em] text-[#b08d57] font-semibold">
                                    Guest Preferences
                                </p>

                                <h2 class="font-serif text-3xl text-[#241d17] mt-2">
                                    Stay Preferences
                                </h2>

                                <p class="text-sm text-stone-500 mt-2">
                                    Save your preferences for future stays.
                                </p>

                            </div>


                            <button type="button"
                                    id="modify-preferences"
                                    class="rounded-xl border border-stone-300 px-5 py-3 text-sm font-semibold text-stone-700 hover:bg-stone-50 transition">

                                <span class="material-symbols-outlined align-middle text-base mr-1">
                                    edit
                                </span>

                                Modify Preferences

                            </button>

                        </div>


                        <!-- =================================================
                             DISPLAY MODE
                        ================================================== -->
                        <div id="preferences-display"
                             class="grid grid-cols-1 md:grid-cols-3 gap-5">


                            <!-- Breakfast -->

                            <div class="rounded-2xl border border-stone-200 p-5">

                                <div class="w-11 h-11 rounded-xl bg-[#f8f3eb] flex items-center justify-center text-[#b08d57]">

                                    <span class="material-symbols-outlined">
                                        restaurant
                                    </span>

                                </div>

                                <h3 class="font-semibold text-[#241d17] mt-4">
                                    Breakfast
                                </h3>

                                <p class="text-sm text-stone-500 mt-2">

                                    @(Model.BreakfastPreference
                                        ? "Requested"
                                        : "Not requested")

                                </p>

                            </div>


                            <!-- Airport Pickup -->

                            <div class="rounded-2xl border border-stone-200 p-5">

                                <div class="w-11 h-11 rounded-xl bg-[#f8f3eb] flex items-center justify-center text-[#b08d57]">

                                    <span class="material-symbols-outlined">
                                        airport_shuttle
                                    </span>

                                </div>

                                <h3 class="font-semibold text-[#241d17] mt-4">
                                    Airport Pickup
                                </h3>

                                <p class="text-sm text-stone-500 mt-2">

                                    @(Model.AirportPickupPreference
                                        ? "Requested"
                                        : "Not requested")

                                </p>

                            </div>


                            <!-- Late Checkout -->

                            <div class="rounded-2xl border border-stone-200 p-5">

                                <div class="w-11 h-11 rounded-xl bg-[#f8f3eb] flex items-center justify-center text-[#b08d57]">

                                    <span class="material-symbols-outlined">
                                        schedule
                                    </span>

                                </div>

                                <h3 class="font-semibold text-[#241d17] mt-4">
                                    Late Checkout
                                </h3>

                                <p class="text-sm text-stone-500 mt-2">

                                    @(Model.LateCheckoutPreference
                                        ? "Requested"
                                        : "Not requested")

                                </p>

                            </div>


                            <!-- Room View -->

                            <div class="rounded-2xl border border-stone-200 p-5 md:col-span-3">

                                <div class="flex items-center gap-3">

                                    <div class="w-11 h-11 rounded-xl bg-[#f8f3eb] flex items-center justify-center text-[#b08d57]">

                                        <span class="material-symbols-outlined">
                                            landscape
                                        </span>

                                    </div>

                                    <div>

                                        <h3 class="font-semibold text-[#241d17]">
                                            Preferred Room View
                                        </h3>

                                        <p class="text-sm text-stone-500">

                                            @(string.IsNullOrWhiteSpace(Model.PreferredRoomView)
                                                ? "No preference"
                                                : Model.PreferredRoomView)

                                        </p>

                                    </div>

                                </div>

                            </div>


                            <!-- Special Requests -->

                            <div class="rounded-2xl border border-stone-200 p-5 md:col-span-3">

                                <div class="flex items-start gap-3">

                                    <div class="w-11 h-11 shrink-0 rounded-xl bg-[#f8f3eb] flex items-center justify-center text-[#b08d57]">

                                        <span class="material-symbols-outlined">
                                            notes
                                        </span>

                                    </div>

                                    <div>

                                        <h3 class="font-semibold text-[#241d17]">
                                            Special Requests
                                        </h3>

                                        <p class="text-sm text-stone-500 mt-2">

                                            @(string.IsNullOrWhiteSpace(Model.SpecialRequests)
                                                ? "No special requests"
                                                : Model.SpecialRequests)

                                        </p>

                                    </div>

                                </div>

                            </div>

                        </div>


                        <!-- =================================================
                             EDIT MODE
                        ================================================== -->
                        <div id="preferences-editor"
                             class="hidden mt-6">

                            <form asp-controller="Account"
                                  asp-action="UpdateStayPreferences"
                                  method="post"
                                  class="space-y-6">

                                @Html.AntiForgeryToken()


                                <!-- Preference Checkboxes -->

                                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">


                                    <!-- Breakfast -->

                                    <label class="flex items-center gap-4 rounded-2xl border border-stone-200 p-5 cursor-pointer hover:bg-stone-50 transition">

                                        <input asp-for="BreakfastPreference"
                                               type="checkbox"
                                               class="h-5 w-5 rounded border-stone-300 text-[#b08d57] focus:ring-[#b08d57]" />

                                        <div>

                                            <p class="font-semibold text-[#241d17]">
                                                Breakfast
                                            </p>

                                            <p class="text-xs text-stone-500 mt-1">
                                                Request breakfast for future stays.
                                            </p>

                                        </div>

                                    </label>


                                    <!-- Airport -->

                                    <label class="flex items-center gap-4 rounded-2xl border border-stone-200 p-5 cursor-pointer hover:bg-stone-50 transition">

                                        <input asp-for="AirportPickupPreference"
                                               type="checkbox"
                                               class="h-5 w-5 rounded border-stone-300 text-[#b08d57] focus:ring-[#b08d57]" />

                                        <div>

                                            <p class="font-semibold text-[#241d17]">
                                                Airport Pickup
                                            </p>

                                            <p class="text-xs text-stone-500 mt-1">
                                                Request airport transportation.
                                            </p>

                                        </div>

                                    </label>


                                    <!-- Late Checkout -->

                                    <label class="flex items-center gap-4 rounded-2xl border border-stone-200 p-5 cursor-pointer hover:bg-stone-50 transition">

                                        <input asp-for="LateCheckoutPreference"
                                               type="checkbox"
                                               class="h-5 w-5 rounded border-stone-300 text-[#b08d57] focus:ring-[#b08d57]" />

                                        <div>

                                            <p class="font-semibold text-[#241d17]">
                                                Late Checkout
                                            </p>

                                            <p class="text-xs text-stone-500 mt-1">
                                                Request late checkout when available.
                                            </p>

                                        </div>

                                    </label>

                                </div>


                                <!-- Room View -->

                                <div>

                                    <label asp-for="PreferredRoomView"
                                           class="block text-sm font-semibold text-stone-700 mb-2">

                                        Preferred Room View

                                    </label>

                                    <select asp-for="PreferredRoomView"
                                            class="w-full rounded-xl border border-stone-300 bg-white px-4 py-3 outline-none focus:border-[#b08d57] focus:ring-2 focus:ring-[#b08d57]/20">

                                        <option value="">
                                            No Preference
                                        </option>

                                        <option value="City View">
                                            City View
                                        </option>

                                        <option value="Sea View">
                                            Sea View
                                        </option>

                                        <option value="Garden View">
                                            Garden View
                                        </option>

                                    </select>

                                </div>


                                <!-- Special Requests -->

                                <div>

                                    <label asp-for="SpecialRequests"
                                           class="block text-sm font-semibold text-stone-700 mb-2">

                                        Special Requests

                                    </label>

                                    <textarea asp-for="SpecialRequests"
                                              rows="4"
                                              maxlength="1000"
                                              class="w-full rounded-xl border border-stone-300 px-4 py-3 outline-none focus:border-[#b08d57] focus:ring-2 focus:ring-[#b08d57]/20"
                                              placeholder="Anything we should know before your stay?"></textarea>

                                    <p class="text-xs text-stone-400 mt-2">
                                        Maximum 1000 characters.
                                    </p>

                                </div>


                                <!-- Buttons -->

                                <div class="flex flex-col sm:flex-row justify-end gap-3 pt-4 border-t border-stone-200">

                                    <button type="button"
                                            id="cancel-preferences"
                                            class="rounded-xl border border-stone-300 px-6 py-3 text-sm font-semibold text-stone-700 hover:bg-stone-50 transition">

                                        Cancel

                                    </button>


                                    <button type="submit"
                                            class="rounded-xl bg-[#b08d57] px-6 py-3 text-sm font-semibold text-white hover:bg-[#9a7849] transition">

                                        <span class="material-symbols-outlined align-middle text-base mr-1">
                                            save
                                        </span>

                                        Save Preferences

                                    </button>

                                </div>

                            </form>

                        </div>

                    </section>


                    <!-- =================================================
                         PAYMENT METHODS
                    ================================================== -->
                    <section id="payment-methods"
                             class="bg-white rounded-2xl border border-stone-200 shadow-sm p-6 md:p-8">

                        <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4 mb-8">

                            <div>

                                <p class="text-xs uppercase tracking-[0.2em] text-[#b08d57] font-semibold">
                                    Billing
                                </p>

                                <h2 class="font-serif text-3xl text-[#241d17] mt-2">
                                    Payment Methods
                                </h2>

                                <p class="text-sm text-stone-500 mt-2">
                                    Secure payment methods connected through Paymob.
                                </p>

                            </div>


                            <button type="button"
                                    id="add-card"
                                    class="rounded-xl border border-stone-300 px-5 py-3 text-sm font-semibold text-stone-700 hover:bg-stone-50 transition">

                                <span class="material-symbols-outlined align-middle text-base mr-1">
                                    add_card
                                </span>

                                Add Card

                            </button>

                        </div>


                        @if (!string.IsNullOrWhiteSpace(Model.PaymobMaskedPan))
                        {
                            <!-- ===============================
                                 SAVED CARD
                            ================================ -->
                            <div class="rounded-2xl border border-stone-200 bg-white p-5">

                                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">

                                    <div class="flex items-center gap-4">

                                        <div class="w-12 h-12 rounded-xl bg-[#f8f3eb] flex items-center justify-center">

                                            <span class="material-symbols-outlined text-[#b08d57]">
                                                credit_card
                                            </span>

                                        </div>


                                        <div>

                                            <p class="font-semibold text-[#241d17]">

                                                @(string.IsNullOrWhiteSpace(Model.PaymobCardSubtype)
                                                    ? "Saved Card"
                                                    : Model.PaymobCardSubtype)

                                                @Model.PaymobMaskedPan

                                            </p>

                                            <p class="text-xs text-stone-500 mt-1">

                                                @(string.IsNullOrWhiteSpace(Model.PaymobCardHolderName)
                                                    ? "Cardholder"
                                                    : Model.PaymobCardHolderName)

                                            </p>

                                            @if (Model.PaymobCardSavedAt.HasValue)
                                            {
                                                <p class="text-xs text-stone-400 mt-1">

                                                    Added
                                                    @Model.PaymobCardSavedAt.Value.ToString("MMM dd, yyyy")

                                                </p>
                                            }

                                        </div>

                                    </div>


                                    <button type="button"
                                            id="remove-card"
                                            class="rounded-xl border border-red-200 px-4 py-2.5 text-sm font-semibold text-red-600 hover:bg-red-50 transition">

                                        Remove

                                    </button>

                                </div>

                            </div>
                        }
                        else
                        {
                            <!-- ===============================
                                 NO CARD
                            ================================ -->
                            <div class="rounded-2xl border border-dashed border-stone-300 bg-stone-50 p-8 text-center">

                                <div class="mx-auto w-14 h-14 rounded-full bg-white border border-stone-200 flex items-center justify-center">

                                    <span class="material-symbols-outlined text-[#b08d57] text-2xl">
                                        credit_card
                                    </span>

                                </div>


                                <h3 class="font-semibold text-[#241d17] mt-4">
                                    No saved payment methods
                                </h3>


                                <p class="text-sm text-stone-500 mt-2 max-w-md mx-auto">

                                    Add a card securely through Paymob.
                                    EMA Hotel does not store your full card number or CVV.

                                </p>

                            </div>
                        }

                    </section>

                </main>

            </div>

        </div>

    </section>

</div>


<!-- =========================================================
     PROFILE IMAGE MODAL
========================================================== -->
<div id="profileImageModal"
     class="fixed inset-0 z-[9999] hidden items-center justify-center bg-black/80 p-4"
     onclick="closeProfileImage()">

    <div class="relative max-w-4xl max-h-[90vh]"
         onclick="event.stopPropagation()">

        <button type="button"
                onclick="closeProfileImage()"
                class="absolute -top-12 right-0 flex h-10 w-10 items-center justify-center rounded-full bg-white/10 text-white text-2xl hover:bg-white/20 transition">

            &times;

        </button>


        <img id="profileImageLarge"
             src=""
             alt="Profile photo"
             class="max-h-[85vh] max-w-full rounded-2xl object-contain shadow-2xl" />

    </div>

</div>


@section Scripts
{

    <partial name="_ValidationScriptsPartial" />


    <script>

        // =========================================================
        // PASSWORD VISIBILITY
        // =========================================================

        function togglePasswordVisibility(inputId, button) {

            const input =
                document.getElementById(inputId);

            if (!input) {
                return;
            }

            const icon =
                button.querySelector(
                    ".material-symbols-outlined"
                );


            if (input.type === "password") {

                input.type = "text";

                if (icon) {
                    icon.textContent =
                        "visibility_off";
                }

            }
            else {

                input.type = "password";

                if (icon) {
                    icon.textContent =
                        "visibility";
                }

            }

        }


        // =========================================================
        // PERSONAL DETAILS - DISCARD
        // =========================================================

        const discardPersonalButton =
            document.getElementById(
                "discard-personal"
            );


        if (discardPersonalButton) {

            discardPersonalButton.addEventListener(
                "click",
                function () {

                    window.location.reload();

                }
            );

        }


        // =========================================================
        // PROFILE IMAGE
        // =========================================================

        const profileImageInput =
            document.getElementById(
                "profile-image-input"
            );


        const changeProfilePhotoButton =
            document.getElementById(
                "change-profile-photo"
            );


        const uploadProfilePhotoButton =
            document.getElementById(
                "upload-profile-photo"
            );


        const cancelPhotoSelectionButton =
            document.getElementById(
                "cancel-photo-selection"
            );


        const selectedPhotoInfo =
            document.getElementById(
                "selected-photo-info"
            );


        const selectedPhotoName =
            document.getElementById(
                "selected-photo-name"
            );


        const selectedPhotoSize =
            document.getElementById(
                "selected-photo-size"
            );


        const photoValidationMessage =
            document.getElementById(
                "photo-validation-message"
            );


        const profileImagePreview =
            document.getElementById(
                "profile-image-preview"
            );


        // IMPORTANT:
        // This exactly matches the HTML id.
        const profileImage =
            document.getElementById(
                "profileImage"
            );


        const profileInitials =
            document.getElementById(
                "profile-initials"
            );


        const MAX_PROFILE_IMAGE_SIZE =
            5 * 1024 * 1024;


        const ALLOWED_PROFILE_EXTENSIONS = [
            ".jpg",
            ".jpeg",
            ".png",
            ".webp"
        ];


        const ALLOWED_PROFILE_TYPES = [
            "image/jpeg",
            "image/png",
            "image/webp"
        ];


        // =========================================================
        // RESET PHOTO
        // =========================================================

        function resetPhotoSelection() {

            if (profileImageInput) {
                profileImageInput.value = "";
            }


            if (selectedPhotoInfo) {
                selectedPhotoInfo.classList.add(
                    "hidden"
                );
            }


            if (uploadProfilePhotoButton) {

                uploadProfilePhotoButton.classList.add(
                    "hidden"
                );

                uploadProfilePhotoButton.disabled =
                    false;

            }


            if (cancelPhotoSelectionButton) {

                cancelPhotoSelectionButton.classList.add(
                    "hidden"
                );

            }


            if (photoValidationMessage) {

                photoValidationMessage.textContent =
                    "";

                photoValidationMessage.classList.add(
                    "hidden"
                );

            }


            if (profileImagePreview) {

                profileImagePreview.src = "";

                profileImagePreview.classList.add(
                    "hidden"
                );

            }


            if (profileImage) {

                profileImage.classList.remove(
                    "hidden"
                );

            }


            if (!profileImage &&
                profileInitials) {

                profileInitials.classList.remove(
                    "hidden"
                );

            }

        }


        // =========================================================
        // VALIDATION ERROR
        // =========================================================

        function showPhotoValidationError(
            message
        ) {

            if (photoValidationMessage) {

                photoValidationMessage.textContent =
                    message;

                photoValidationMessage.classList.remove(
                    "hidden"
                );

            }


            if (selectedPhotoInfo) {

                selectedPhotoInfo.classList.add(
                    "hidden"
                );

            }


            if (uploadProfilePhotoButton) {

                uploadProfilePhotoButton.classList.add(
                    "hidden"
                );

            }


            if (cancelPhotoSelectionButton) {

                cancelPhotoSelectionButton.classList.remove(
                    "hidden"
                );

            }


            if (profileImagePreview) {

                profileImagePreview.src = "";

                profileImagePreview.classList.add(
                    "hidden"
                );

            }


            if (profileImage) {

                profileImage.classList.remove(
                    "hidden"
                );

            }


            if (!profileImage &&
                profileInitials) {

                profileInitials.classList.remove(
                    "hidden"
                );

            }

        }


        // =========================================================
        // CLEAR PHOTO ERROR
        // =========================================================

        function clearPhotoValidationError() {

            if (photoValidationMessage) {

                photoValidationMessage.textContent =
                    "";

                photoValidationMessage.classList.add(
                    "hidden"
                );

            }

        }


        // =========================================================
        // FORMAT FILE SIZE
        // =========================================================

        function formatFileSize(bytes) {

            if (bytes < 1024) {
                return bytes + " B";
            }


            if (bytes < 1024 * 1024) {

                return (
                    bytes / 1024
                ).toFixed(1) + " KB";

            }


            return (
                bytes / (1024 * 1024)
            ).toFixed(2) + " MB";

        }


        // =========================================================
        // OPEN FILE PICKER
        // =========================================================

        if (
            changeProfilePhotoButton &&
            profileImageInput
        ) {

            changeProfilePhotoButton.addEventListener(
                "click",
                function () {

                    profileImageInput.click();

                }
            );

        }


        // =========================================================
        // FILE SELECTED
        // =========================================================

        if (profileImageInput) {

            profileImageInput.addEventListener(
                "change",
                function () {

                    const file =
                        this.files &&
                        this.files.length > 0
                            ? this.files[0]
                            : null;


                    if (!file) {

                        resetPhotoSelection();

                        return;

                    }


                    // -----------------------------------------
                    // Extension
                    // -----------------------------------------

                    const fileName =
                        file.name.toLowerCase();


                    const lastDotIndex =
                        fileName.lastIndexOf(".");


                    const extension =
                        lastDotIndex >= 0
                            ? fileName.substring(
                                lastDotIndex
                            )
                            : "";


                    if (
                        !ALLOWED_PROFILE_EXTENSIONS
                            .includes(extension)
                    ) {

                        this.value = "";

                        showPhotoValidationError(
                            "Only JPG, JPEG, PNG, and WEBP images are allowed."
                        );

                        return;

                    }


                    // -----------------------------------------
                    // MIME
                    // -----------------------------------------

                    if (
                        !ALLOWED_PROFILE_TYPES
                            .includes(file.type)
                    ) {

                        this.value = "";

                        showPhotoValidationError(
                            "Invalid image type."
                        );

                        return;

                    }


                    // -----------------------------------------
                    // Size
                    // -----------------------------------------

                    if (
                        file.size >
                        MAX_PROFILE_IMAGE_SIZE
                    ) {

                        this.value = "";

                        showPhotoValidationError(
                            "The image size must not exceed 5 MB."
                        );

                        return;

                    }


                    // -----------------------------------------
                    // File information
                    // -----------------------------------------

                    if (selectedPhotoName) {

                        selectedPhotoName.textContent =
                            file.name;

                    }


                    if (selectedPhotoSize) {

                        selectedPhotoSize.textContent =
                            formatFileSize(
                                file.size
                            );

                    }


                    if (selectedPhotoInfo) {

                        selectedPhotoInfo.classList.remove(
                            "hidden"
                        );

                    }


                    clearPhotoValidationError();


                    // -----------------------------------------
                    // Preview
                    // -----------------------------------------

                    const reader =
                        new FileReader();


                    reader.onload =
                        function (event) {

                            if (profileImagePreview) {

                                profileImagePreview.src =
                                    event.target.result;

                                profileImagePreview.classList.remove(
                                    "hidden"
                                );

                            }


                            if (profileImage) {

                                profileImage.classList.add(
                                    "hidden"
                                );

                            }


                            if (profileInitials) {

                                profileInitials.classList.add(
                                    "hidden"
                                );

                            }

                        };


                    reader.onerror =
                        function () {

                            showPhotoValidationError(
                                "Could not preview this image."
                            );

                        };


                    reader.readAsDataURL(file);


                    // -----------------------------------------
                    // Buttons
                    // -----------------------------------------

                    if (uploadProfilePhotoButton) {

                        uploadProfilePhotoButton.classList.remove(
                            "hidden"
                        );

                    }


                    if (cancelPhotoSelectionButton) {

                        cancelPhotoSelectionButton.classList.remove(
                            "hidden"
                        );

                    }

                }
            );

        }


        // =========================================================
        // CANCEL PHOTO
        // =========================================================

        if (cancelPhotoSelectionButton) {

            cancelPhotoSelectionButton.addEventListener(
                "click",
                function () {

                    resetPhotoSelection();

                }
            );

        }


        // =========================================================
        // PHOTO FORM SUBMIT
        // =========================================================

        const profileImageForm =
            document.getElementById(
                "profile-image-form"
            );


        if (profileImageForm) {

            profileImageForm.addEventListener(
                "submit",
                function (event) {

                    const file =
                        profileImageInput &&
                        profileImageInput.files &&
                        profileImageInput.files.length > 0
                            ? profileImageInput.files[0]
                            : null;


                    if (!file) {

                        event.preventDefault();

                        showPhotoValidationError(
                            "Please select an image first."
                        );

                        return;

                    }


                    if (
                        !ALLOWED_PROFILE_TYPES
                            .includes(file.type)
                    ) {

                        event.preventDefault();

                        showPhotoValidationError(
                            "Invalid image type."
                        );

                        return;

                    }


                    if (
                        file.size >
                        MAX_PROFILE_IMAGE_SIZE
                    ) {

                        event.preventDefault();

                        showPhotoValidationError(
                            "The image size must not exceed 5 MB."
                        );

                        return;

                    }


                    if (uploadProfilePhotoButton) {

                        uploadProfilePhotoButton.disabled =
                            true;


                        uploadProfilePhotoButton.innerHTML = `
                            <span class="material-symbols-outlined align-middle text-base mr-1">
                                progress_activity
                            </span>
                            Uploading...
                        `;

                    }

                }
            );

        }


        // =========================================================
        // STAY PREFERENCES
        // =========================================================

        const modifyPreferences =
            document.getElementById(
                "modify-preferences"
            );


        const preferencesDisplay =
            document.getElementById(
                "preferences-display"
            );


        const preferencesEditor =
            document.getElementById(
                "preferences-editor"
            );


        const cancelPreferences =
            document.getElementById(
                "cancel-preferences"
            );


        if (modifyPreferences) {

            modifyPreferences.addEventListener(
                "click",
                function () {

                    preferencesDisplay?.classList.add(
                        "hidden"
                    );


                    preferencesEditor?.classList.remove(
                        "hidden"
                    );


                    modifyPreferences.classList.add(
                        "hidden"
                    );

                }
            );

        }


        if (cancelPreferences) {

            cancelPreferences.addEventListener(
                "click",
                function () {

                    preferencesEditor?.classList.add(
                        "hidden"
                    );


                    preferencesDisplay?.classList.remove(
                        "hidden"
                    );


                    modifyPreferences?.classList.remove(
                        "hidden"
                    );

                }
            );

        }


        // =========================================================
        // PAYMENT METHODS
        // =========================================================

        const addCard =
            document.getElementById(
                "add-card"
            );


        if (addCard) {
            addCard.addEventListener("click", function () {
                window.location.href = "/Account/AddCard";
            });
        }


        // =========================================================
        // REMOVE CARD
        // =========================================================

        const removeCard =
            document.getElementById(
                "remove-card"
            );


        if (removeCard) {

            removeCard.addEventListener(
                "click",
                function () {

                    const confirmed =
                        window.confirm(
                            "Are you sure you want to remove this saved card?"
                        );


                    if (!confirmed) {
                        return;
                    }


                    window.location.href =
                        "/Account/RemoveCard";

                }
            );

        }


        // =========================================================
        // PROFILE IMAGE MODAL
        // =========================================================

        function openProfileImage() {

            const image =
                document.getElementById(
                    "profileImage"
                );


            const modal =
                document.getElementById(
                    "profileImageModal"
                );


            const largeImage =
                document.getElementById(
                    "profileImageLarge"
                );


            if (
                !image ||
                !modal ||
                !largeImage
            ) {

                return;

            }


            largeImage.src =
                image.src;


            modal.classList.remove(
                "hidden"
            );


            modal.classList.add(
                "flex"
            );


            document.body.classList.add(
                "overflow-hidden"
            );

        }


        function closeProfileImage() {

            const modal =
                document.getElementById(
                    "profileImageModal"
                );


            const largeImage =
                document.getElementById(
                    "profileImageLarge"
                );


            if (!modal) {
                return;
            }


            modal.classList.add(
                "hidden"
            );


            modal.classList.remove(
                "flex"
            );


            document.body.classList.remove(
                "overflow-hidden"
            );


            if (largeImage) {

                largeImage.src = "";

            }

        }


        // =========================================================
        // ESCAPE MODAL
        // =========================================================

        document.addEventListener(
            "keydown",
            function (event) {

                if (
                    event.key === "Escape"
                ) {

                    closeProfileImage();

                }

            }
        );


        // =========================================================
        // SMOOTH SCROLL
        // =========================================================

        document
            .querySelectorAll(
                'a[href^="#"]'
            )
            .forEach(
                function (link) {

                    link.addEventListener(
                        "click",
                        function (event) {

                            const targetId =
                                this.getAttribute(
                                    "href"
                                );


                            if (
                                !targetId ||
                                targetId === "#"
                            ) {

                                return;

                            }


                            const target =
                                document.querySelector(
                                    targetId
                                );


                            if (!target) {

                                return;

                            }


                            event.preventDefault();


                            target.scrollIntoView({
                                behavior: "smooth",
                                block: "start"
                            });

                        }
                    );

                }
            );

    </script>
}

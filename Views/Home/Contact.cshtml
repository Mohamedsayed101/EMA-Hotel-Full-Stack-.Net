@model Hotel_MVC.ViewModels.Contact.ContactVM

@{
    ViewData["Title"] = "Contact EMA Hotel";
}

<div class="flex flex-col w-full">

    <!-- ================= CONTACT HERO ================= -->
    <section class="relative w-full overflow-hidden bg-surface py-16 lg:py-24">

        <!-- Decorative Background -->
        <div class="absolute inset-0 pointer-events-none opacity-40">
            <div class="absolute -top-32 right-10 w-96 h-96 rounded-full bg-primary/10 blur-3xl"></div>

            <div class="absolute bottom-0 left-12 w-80 h-80 rounded-full bg-primary-fixed/20 blur-2xl"></div>
        </div>

        <!-- Content -->
        <div class="relative max-w-[1320px] mx-auto px-6 lg:px-margin">

            <!-- ================= HERO TEXT ================= -->
            <div class="flex flex-col items-center text-center max-w-2xl mx-auto mb-16 lg:mb-20">

                <span class="font-label-caps text-label-caps text-primary tracking-[0.25em] uppercase mb-4">
                    Concierge &amp; Guest Relations
                </span>

                <h1 class="font-headline-lg text-headline-lg text-on-surface font-medium tracking-tight mb-4">
                    Contact EMA Hotel
                </h1>

                <p class="font-body-lead text-body-lead text-on-surface-variant font-normal">
                    Our dedicated concierge team is at your service 24/7.
                </p>

                <div class="w-12 h-[2px] bg-primary/40 mt-8"></div>

            </div>


            <!-- ================= CONTACT DETAILS ================= -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-gutter items-start">

                <!-- ================= SEND AN INQUIRY ================= -->
                <div class="lg:col-span-7 bg-surface-container-lowest rounded-xl
                    shadow-[0_8px_30px_rgba(43,38,35,0.05)]
                    p-8 sm:p-12 transition-all">

                    <!-- Header -->
                    <div class="flex items-center justify-between mb-8 pb-4">

                        <div>

                            <span class="font-label-caps text-label-caps uppercase
                                text-primary tracking-wider">
                                Direct Message
                            </span>

                            <h2 class="font-headline-sm text-headline-sm
                                text-on-surface mt-1">
                                Send an Inquiry
                            </h2>

                        </div>

                        <span class="material-symbols-outlined text-primary text-3xl">
                            edit_note
                        </span>

                    </div>


                    <!-- ================= SUCCESS MESSAGE ================= -->
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="mb-6 rounded-lg
                            bg-green-50
                            border border-green-200
                            px-5 py-4
                            text-green-700 text-sm">

                            @TempData["SuccessMessage"]

                        </div>
                    }


                    <!-- ================= CONTACT FORM ================= -->
                    <form asp-controller="Home"
                          asp-action="SendMessage"
                          method="post"
                          class="space-y-6"
                          id="contact-form">

                        <!-- ================= NAME + EMAIL ================= -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">

                            <!-- Full Name -->
                            <div class="flex flex-col gap-2">

                                <label class="font-label-md text-label-md
                                    text-on-surface-variant"
                                       for="full-name">

                                    Full Name

                                </label>

                                <div class="relative flex items-center">

                                    <span class="material-symbols-outlined
                                        absolute left-4
                                        text-outline text-[19px]">
                                        person
                                    </span>

                                    <input asp-for="FullName"
                                           class="w-full h-12 pl-12 pr-4
                                    bg-surface-container-low
                                    text-on-surface
                                    rounded
                                    font-body-md text-body-md
                                    focus:bg-surface-container-lowest
                                    focus:outline-none
                                    transition-all
                                    placeholder:text-outline/60
                                    shadow-sm"
                                           id="full-name"
                                           placeholder="Lord Julian Vance"
                                           type="text" />

                                </div>

                                <span asp-validation-for="FullName"
                                      class="text-red-500 text-sm">
                                </span>

                            </div>


                            <!-- Email -->
                            <div class="flex flex-col gap-2">

                                <label class="font-label-md text-label-md
                                    text-on-surface-variant"
                                       for="email">

                                    Email Address

                                </label>

                                <div class="relative flex items-center">

                                    <span class="material-symbols-outlined
                                        absolute left-4
                                        text-outline text-[19px]">
                                        alternate_email
                                    </span>

                                    <input asp-for="Email"
                                           class="w-full h-12 pl-12 pr-4
                                    bg-surface-container-low
                                    text-on-surface
                                    rounded
                                    font-body-md text-body-md
                                    focus:bg-surface-container-lowest
                                    focus:outline-none
                                    transition-all
                                    placeholder:text-outline/60
                                    shadow-sm"
                                           id="email"
                                           placeholder="julian@vance-holdings.com"
                                           type="email" />

                                </div>

                                <span asp-validation-for="Email"
                                      class="text-red-500 text-sm">
                                </span>

                            </div>

                        </div>


                        <!-- ================= SUBJECT ================= -->
                        <div class="flex flex-col gap-2">

                            <label class="font-label-md text-label-md
                                text-on-surface-variant"
                                   for="subject">

                                Inquiry Subject

                            </label>

                            <div class="relative flex items-center">

                                <span class="material-symbols-outlined
                                    absolute left-4
                                    text-outline text-[19px]">
                                    room_service
                                </span>

                                <select asp-for="Subject"
                                        class="w-full h-12 pl-12 pr-10
                                    bg-surface-container-low
                                    text-on-surface
                                    rounded
                                    font-body-md text-body-md
                                    focus:bg-surface-container-lowest
                                    focus:outline-none
                                    appearance-none
                                    transition-all
                                    cursor-pointer
                                    shadow-sm"
                                        id="subject">

                                    <option value="Reservation Inquiry">
                                        Reservation Inquiry
                                    </option>

                                    <option value="Special Arrangements & Suite Customization">
                                        Special Arrangements &amp; Suite Customization
                                    </option>

                                    <option value="Private Events & Gatherings">
                                        Private Events &amp; Gatherings
                                    </option>

                                    <option value="General Concierge Assistance">
                                        General Concierge Assistance
                                    </option>

                                </select>

                                <span class="material-symbols-outlined
                                    absolute right-4
                                    text-outline
                                    pointer-events-none
                                    text-[20px]">
                                    expand_more
                                </span>

                            </div>

                            <span asp-validation-for="Subject"
                                  class="text-red-500 text-sm">
                            </span>

                        </div>


                        <!-- ================= MESSAGE ================= -->
                        <div class="flex flex-col gap-2">

                            <label class="font-label-md text-label-md
                                text-on-surface-variant"
                                   for="message">

                                Your Message

                            </label>

                            <textarea asp-for="Message"
                                      class="w-full p-4
                            bg-surface-container-low
                            text-on-surface
                            rounded
                            font-body-md text-body-md
                            focus:bg-surface-container-lowest
                            focus:outline-none
                            transition-all
                            placeholder:text-outline/60
                            leading-relaxed
                            resize-none
                            shadow-sm"
                                      id="message"
                                      placeholder="Please detail arrival dates, suite preferences, or specific dietary and transport provisions..."
                                      rows="5"></textarea>

                            <span asp-validation-for="Message"
                                  class="text-red-500 text-sm">
                            </span>

                        </div>


                        <!-- ================= BUTTON ================= -->
                        <div class="pt-2
                            flex flex-col sm:flex-row
                            items-start sm:items-center
                            justify-between
                            gap-4">

                            <button class="w-full sm:w-auto
                                px-8 py-3.5
                                bg-primary
                                text-on-primary
                                font-label-md text-label-md
                                uppercase
                                tracking-wider
                                rounded
                                hover:bg-primary-container
                                transition-all
                                shadow-[0_4px_16px_rgba(121,85,30,0.22)]
                                active:scale-[0.99]
                                flex items-center
                                justify-center
                                gap-2"
                                    type="submit">

                                <span>
                                    Send Message
                                </span>

                                <span class="material-symbols-outlined text-[18px]">
                                    arrow_forward
                                </span>

                            </button>


                            <div class="flex items-center gap-2
                                text-on-surface-variant
                                font-label-sm text-label-sm">

                                <span class="material-symbols-outlined
                                    text-primary text-[17px]">
                                    schedule
                                </span>

                                <span>
                                    Replies are typically delivered within 2 hours.
                                </span>

                            </div>

                        </div>


                        <!-- ================= VALIDATION SUMMARY ================= -->
                        <div asp-validation-summary="ModelOnly"
                             class="text-red-500 text-sm">
                        </div>

                    </form>

                </div>


                <!-- ================= SANCTUARY PRESENCE ================= -->
                <div class="lg:col-span-5 flex flex-col gap-6">

                    <!-- ================= CONTACT DETAILS CARD ================= -->
                    <div class="bg-surface-container-lowest rounded-xl
                        shadow-[0_8px_30px_rgba(43,38,35,0.05)]
                        p-8">

                        <span class="font-label-caps text-label-caps uppercase
                            text-primary tracking-wider mb-6 block">

                            Sanctuary Presence

                        </span>


                        <div class="space-y-6">

                            <!-- ================= PHONE ================= -->
                            <div class="flex items-start gap-4">

                                <div class="w-10 h-10 rounded-full
                                    bg-surface-container
                                    flex items-center justify-center
                                    text-primary shrink-0">

                                    <span class="material-symbols-outlined text-[20px]">
                                        phone_in_talk
                                    </span>

                                </div>


                                <div>

                                    <h3 class="font-label-md text-label-md
                                        text-on-surface font-semibold">

                                        Concierge Direct Phone

                                    </h3>

                                    <p class="font-body-md text-body-md
                                        text-on-surface-variant mt-1">

                                        +1 (800) 555-EMA-HOTEL

                                    </p>

                                    <p class="font-body-sm text-body-sm text-outline">

                                        +1 (310) 555-0199 (Direct Desk)

                                    </p>

                                </div>

                            </div>


                            <!-- ================= EMAIL ================= -->
                            <div class="flex items-start gap-4">

                                <div class="w-10 h-10 rounded-full
                                    bg-surface-container
                                    flex items-center justify-center
                                    text-primary shrink-0">

                                    <span class="material-symbols-outlined text-[20px]">
                                        mark_email_read
                                    </span>

                                </div>


                                <div>

                                    <h3 class="font-label-md text-label-md
                                        text-on-surface font-semibold">

                                        Direct Correspondence

                                    </h3>

                                    <a class="font-body-md text-body-md
                                        text-primary
                                        block mt-1
                                        hover:underline"
                                       href="mailto:reservations@emahotel.com">

                                        reservations@emahotel.com

                                    </a>

                                    <a class="font-body-sm text-body-sm
                                        text-outline
                                        block
                                        hover:underline"
                                       href="mailto:concierge@emahotel.com">

                                        concierge@emahotel.com

                                    </a>

                                </div>

                            </div>


                            <!-- ================= LOCATION ================= -->
                            <div class="flex items-start gap-4">

                                <div class="w-10 h-10 rounded-full
                                    bg-surface-container
                                    flex items-center justify-center
                                    text-primary shrink-0">

                                    <span class="material-symbols-outlined text-[20px]">
                                        pin_drop
                                    </span>

                                </div>


                                <div>

                                    <h3 class="font-label-md text-label-md
                                        text-on-surface font-semibold">

                                        Location

                                    </h3>

                                    <p class="font-body-md text-body-md
                                        text-on-surface-variant
                                        mt-1
                                        leading-relaxed">

                                        742 Coastal Boulevard,<br />
                                        Malibu Beach, CA 90265

                                    </p>

                                </div>

                            </div>


                            <!-- ================= HOURS ================= -->
                            <div class="flex items-start gap-4">

                                <div class="w-10 h-10 rounded-full
                                    bg-surface-container
                                    flex items-center justify-center
                                    text-primary shrink-0">

                                    <span class="material-symbols-outlined text-[20px]">
                                        hourglass_top
                                    </span>

                                </div>


                                <div>

                                    <h3 class="font-label-md text-label-md
                                        text-on-surface font-semibold">

                                        Operating Hours

                                    </h3>

                                    <p class="font-body-md text-body-md
                                        text-on-surface-variant mt-1">

                                        Concierge Desk available 24 hours, 7 days a week

                                    </p>

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- ================= ORIGINAL MAP ================= -->
                    <div class="bg-surface-container-lowest
                        rounded-xl
                        overflow-hidden
                        shadow-[0_8px_30px_rgba(43,38,35,0.05)]
                        p-2">

                        <div class="relative w-full h-56
                            rounded-lg
                            bg-cover
                            bg-center
                            overflow-hidden
                            flex flex-col
                            justify-between
                            p-4"
                             data-location="742 Coastal Boulevard, Malibu Beach, CA 90265"
                             style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuBNTJwcO9P1k0DgRculdSEddLY12xd23WOklb2hgr8n1dS2GhrwdjoR-INXYtVPKVks-XICmQwaoR_HHAi1HLkl5_-MbDA118pZgfSXqpgK-LeWiC3rq9UqyRfRBFQ8Fa5R0G02GWRUrUhWVF62qiljIIx8ziRA9yD4wEHgeOUrwZIEiChriC_fDFZAOmgs2WSP2FXfM8-bGd6zCZK6SDbezrvphdBguJpYL_SSJBDzyW0FTmZ89udk')">

                            <!-- Airport Badge -->
                            <div class="self-end
                                bg-surface/90
                                backdrop-blur-md
                                px-3 py-1.5
                                rounded
                                text-on-surface
                                font-label-sm text-label-sm
                                shadow-sm
                                flex items-center gap-1.5">

                                <span class="material-symbols-outlined
                                    text-primary text-[15px]">

                                    flight

                                </span>

                                <span>
                                    LAX Airport: 25 mins
                                </span>

                            </div>


                            <!-- Location Overlay -->
                            <div class="bg-surface/95
                                backdrop-blur-md
                                p-3
                                rounded
                                flex items-center
                                justify-between
                                shadow-sm">

                                <div class="flex items-center gap-2">

                                    <span class="material-symbols-outlined
                                        text-primary text-[20px]">

                                        explore

                                    </span>

                                    <span class="font-label-md text-label-md
                                        text-on-surface">

                                        Pacific Coast Sanctuary

                                    </span>

                                </div>


                                <a href="https://maps.google.com"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   class="font-label-caps text-label-caps
                                    text-primary
                                    uppercase
                                    tracking-wider
                                    hover:underline
                                    flex items-center gap-1">

                                    <span>
                                        Get Directions
                                    </span>

                                    <span class="material-symbols-outlined text-[14px]">
                                        open_in_new
                                    </span>

                                </a>

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- ================= FAQ ================= -->
            <div class="mt-16 lg:mt-20">

                <div class="max-w-2xl mb-8">

                    <span class="font-label-caps text-label-caps uppercase
                        text-primary tracking-wider">

                        Frequently Asked Questions

                    </span>

                    <h2 class="font-headline-sm text-headline-sm
                        text-on-surface mt-1">

                        Before You Arrive

                    </h2>

                    <p class="font-body-md text-body-md
                        text-on-surface-variant mt-2">

                        A few answers to the questions our guests ask most often.

                    </p>

                </div>


                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

                    <!-- ================= FAQ 1 ================= -->
                    <details class="group bg-surface-container-lowest
                        rounded-xl p-6
                        shadow-[0_8px_30px_rgba(43,38,35,0.05)]">

                        <summary class="list-none cursor-pointer
                            flex items-center
                            justify-between gap-4">

                            <span class="font-label-md text-label-md
                                text-on-surface font-semibold">

                                What are the check-in and check-out times?

                            </span>

                            <span class="material-symbols-outlined
                                text-primary
                                transition-transform
                                group-open:rotate-180">

                                expand_more

                            </span>

                        </summary>


                        <p class="font-body-sm text-body-sm
                            text-on-surface-variant
                            leading-relaxed mt-4">

                            Standard check-in begins at 3:00 PM and check-out is
                            at 12:00 PM. Early check-in and late check-out can
                            be requested through our concierge team.

                        </p>

                    </details>


                    <!-- ================= FAQ 2 ================= -->
                    <details class="group bg-surface-container-lowest
                        rounded-xl p-6
                        shadow-[0_8px_30px_rgba(43,38,35,0.05)]">

                        <summary class="list-none cursor-pointer
                            flex items-center
                            justify-between gap-4">

                            <span class="font-label-md text-label-md
                                text-on-surface font-semibold">

                                Can I arrange special requests before arrival?

                            </span>

                            <span class="material-symbols-outlined
                                text-primary
                                transition-transform
                                group-open:rotate-180">

                                expand_more

                            </span>

                        </summary>


                        <p class="font-body-sm text-body-sm
                            text-on-surface-variant
                            leading-relaxed mt-4">

                            Absolutely. Our concierge team can assist with
                            transportation, dining preferences, celebrations,
                            room arrangements, and other special requests.

                        </p>

                    </details>


                    <!-- ================= FAQ 3 ================= -->
                    <details class="group bg-surface-container-lowest
                        rounded-xl p-6
                        shadow-[0_8px_30px_rgba(43,38,35,0.05)]">

                        <summary class="list-none cursor-pointer
                            flex items-center
                            justify-between gap-4">

                            <span class="font-label-md text-label-md
                                text-on-surface font-semibold">

                                How can I contact the concierge team?

                            </span>

                            <span class="material-symbols-outlined
                                text-primary
                                transition-transform
                                group-open:rotate-180">

                                expand_more

                            </span>

                        </summary>


                        <p class="font-body-sm text-body-sm
                            text-on-surface-variant
                            leading-relaxed mt-4">

                            Our concierge desk is available 24 hours a day,
                            7 days a week by phone or email. You can also
                            send us an inquiry directly through this page.

                        </p>

                    </details>

                </div>

            </div>

        </div>

    </section>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}
@using Microsoft.AspNetCore.Mvc.Rendering
@model Hotel_MVC.ViewModels.Receptionist.WalkInBookingVM
@{
    ViewData["Title"] = "New Walk-in Booking";
}

<div class="w-full bg-surface min-h-screen py-10">
    <div class="max-w-3xl mx-auto px-6">

        <!-- Page Header -->
        <div class="mb-6 flex items-center justify-between">
            <div>
                <span class="text-primary font-semibold text-xs uppercase tracking-widest">Concierge Desk</span>
                <h1 class="font-headline text-3xl font-bold text-on-surface mt-1">New Walk-in Reservation</h1>
            </div>
            <a asp-action="Index" class="px-4 py-2 bg-surface-container text-on-surface text-xs font-semibold rounded-lg hover:bg-surface-container-high transition">
                Back to Reception
            </a>
        </div>

        <!-- Form Card -->
        <div class="bg-surface-container-lowest rounded-2xl p-8 shadow-sm border border-black/5">
            <form asp-action="CreateWalkIn" method="post">
                @Html.AntiForgeryToken()

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="mb-6 p-4 rounded-xl bg-red-50 border border-red-200 text-red-700 text-sm">
                        @Html.ValidationSummary(false, "", new { @class = "list-disc pl-5" })
                    </div>
                }

                <div class="space-y-5">
                    <!-- Guest Names -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label asp-for="GuestFirstName" class="block text-xs uppercase font-semibold text-on-surface-variant mb-2">First Name</label>
                            <input asp-for="GuestFirstName" class="w-full px-4 py-3 bg-surface-container-low border border-outline-variant/30 rounded-xl text-sm font-medium focus:ring-2 focus:ring-primary/20 outline-none" required placeholder="Guest first name" />
                            <span asp-validation-for="GuestFirstName" class="text-xs text-red-600 mt-1 block"></span>
                        </div>
                        <div>
                            <label asp-for="GuestLastName" class="block text-xs uppercase font-semibold text-on-surface-variant mb-2">Last Name</label>
                            <input asp-for="GuestLastName" class="w-full px-4 py-3 bg-surface-container-low border border-outline-variant/30 rounded-xl text-sm font-medium focus:ring-2 focus:ring-primary/20 outline-none" required placeholder="Guest last name" />
                            <span asp-validation-for="GuestLastName" class="text-xs text-red-600 mt-1 block"></span>
                        </div>
                    </div>

                    <!-- Contact Info -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label asp-for="GuestEmail" class="block text-xs uppercase font-semibold text-on-surface-variant mb-2">Email Address</label>
                            <input asp-for="GuestEmail" type="email" class="w-full px-4 py-3 bg-surface-container-low border border-outline-variant/30 rounded-xl text-sm font-medium focus:ring-2 focus:ring-primary/20 outline-none" required placeholder="guest@example.com" />
                            <span asp-validation-for="GuestEmail" class="text-xs text-red-600 mt-1 block"></span>
                        </div>
                        <div>
                            <label asp-for="GuestPhone" class="block text-xs uppercase font-semibold text-on-surface-variant mb-2">Phone Number</label>
                            <input asp-for="GuestPhone" class="w-full px-4 py-3 bg-surface-container-low border border-outline-variant/30 rounded-xl text-sm font-medium focus:ring-2 focus:ring-primary/20 outline-none" required placeholder="+20..." />
                            <span asp-validation-for="GuestPhone" class="text-xs text-red-600 mt-1 block"></span>
                        </div>
                    </div>

                    <!-- Room Selection -->
                    <div>
                        <label asp-for="RoomTypeId" class="block text-xs uppercase font-semibold text-on-surface-variant mb-2">Sanctuary Room Type</label>
                        <select asp-for="RoomTypeId" asp-items="@((SelectList)ViewBag.RoomTypes)" class="w-full px-4 py-3 bg-surface-container-low border border-outline-variant/30 rounded-xl text-sm font-medium focus:ring-2 focus:ring-primary/20 outline-none" required>
                            <option value="">-- Select Room Type --</option>
                        </select>
                        <span asp-validation-for="RoomTypeId" class="text-xs text-red-600 mt-1 block"></span>
                    </div>

                    <!-- Stay Dates -->
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                        <div>
                            <label asp-for="CheckIn" class="block text-xs uppercase font-semibold text-on-surface-variant mb-2">Check-in</label>
                            <input asp-for="CheckIn" type="date" min="@DateTime.Today.ToString("yyyy-MM-dd")" class="w-full px-4 py-3 bg-surface-container-low border border-outline-variant/30 rounded-xl text-sm font-medium focus:ring-2 focus:ring-primary/20 outline-none" required />
                            <span asp-validation-for="CheckIn" class="text-xs text-red-600 mt-1 block"></span>
                        </div>
                        <div>
                            <label asp-for="CheckOut" class="block text-xs uppercase font-semibold text-on-surface-variant mb-2">Check-out</label>
                            <input asp-for="CheckOut" type="date" min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" class="w-full px-4 py-3 bg-surface-container-low border border-outline-variant/30 rounded-xl text-sm font-medium focus:ring-2 focus:ring-primary/20 outline-none" required />
                            <span asp-validation-for="CheckOut" class="text-xs text-red-600 mt-1 block"></span>
                        </div>
                        <div>
                            <label asp-for="Guests" class="block text-xs uppercase font-semibold text-on-surface-variant mb-2">Guests Count</label>
                            <input asp-for="Guests" type="number" min="1" max="6" class="w-full px-4 py-3 bg-surface-container-low border border-outline-variant/30 rounded-xl text-sm font-medium focus:ring-2 focus:ring-primary/20 outline-none" required />
                            <span asp-validation-for="Guests" class="text-xs text-red-600 mt-1 block"></span>
                        </div>
                    </div>

                    <!-- Payment Method -->
                    <div>
                        <label asp-for="PaymentMethod" class="block text-xs uppercase font-semibold text-on-surface-variant mb-2">Payment Method</label>
                        <select asp-for="PaymentMethod" class="w-full px-4 py-3 bg-surface-container-low border border-outline-variant/30 rounded-xl text-sm font-medium focus:ring-2 focus:ring-primary/20 outline-none">
                            <option value="Cash">Cash at Desk</option>
                            <option value="Card">Card Terminal</option>
                        </select>
                        <span asp-validation-for="PaymentMethod" class="text-xs text-red-600 mt-1 block"></span>
                    </div>

                    <!-- Action Buttons -->
                    <div class="pt-4 flex items-center justify-end gap-3">
                        <a asp-action="Index" class="px-5 py-2.5 bg-surface-container text-on-surface text-sm font-semibold rounded-xl hover:bg-surface-container-high transition">Cancel</a>
                        <button type="submit" class="px-6 py-2.5 bg-primary text-white text-sm font-semibold rounded-xl hover:bg-primary-container transition shadow-md">Create Walk-in Booking</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
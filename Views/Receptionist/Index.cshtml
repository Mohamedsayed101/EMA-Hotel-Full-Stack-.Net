@model Hotel_MVC.ViewModels.Receptionist.ReceptionistBookingVM
@{
    ViewData["Title"] = "Reception Desk";
}

<div class="w-full bg-surface min-h-screen py-10">
    <div class="max-w-[1320px] mx-auto px-6 lg:px-12 space-y-8">

        <!-- Page Header -->
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
            <div>
                <span class="text-primary font-semibold text-xs uppercase tracking-widest">Concierge Operations</span>
                <h1 class="font-headline text-3xl sm:text-4xl font-bold text-on-surface mt-1">Reception Desk</h1>
                <p class="text-sm text-on-surface-variant mt-1">Manage today's arrivals, departures, and walk-in reservations efficiently.</p>
            </div>
            <div>
                <a asp-action="CreateWalkIn" class="px-6 py-3 bg-primary text-white text-sm font-semibold rounded-xl hover:bg-primary-container transition shadow-md flex items-center gap-2">
                    <span class="material-symbols-outlined text-lg">person_add</span> New Walk-in Booking
                </a>
            </div>
        </div>

        <!-- Alerts -->
        @if (TempData["Success"] != null)
        {
            <div class="p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm flex items-center gap-2">
                <span class="material-symbols-outlined text-lg">check_circle</span>
                <span>@TempData["Success"]</span>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="p-4 rounded-xl bg-red-50 border border-red-200 text-red-700 text-sm flex items-center gap-2">
                <span class="material-symbols-outlined text-lg">error</span>
                <span>@TempData["Error"]</span>
            </div>
        }

        <!-- KPI Cards Grid -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="bg-surface-container-lowest p-6 rounded-2xl shadow-sm border border-black/5 flex items-center justify-between">
                <div>
                    <span class="text-xs uppercase tracking-wider text-on-surface-variant font-semibold">Today's Arrivals</span>
                    <h2 class="font-headline text-3xl font-bold text-on-surface mt-1">@ViewBag.ArrivalsToday</h2>
                    <p class="text-xs text-on-surface-variant mt-0.5">Guests expected for check-in</p>
                </div>
                <div class="w-12 h-12 rounded-xl bg-primary/10 text-primary flex items-center justify-center">
                    <span class="material-symbols-outlined text-2xl">login</span>
                </div>
            </div>

            <div class="bg-surface-container-lowest p-6 rounded-2xl shadow-sm border border-black/5 flex items-center justify-between">
                <div>
                    <span class="text-xs uppercase tracking-wider text-on-surface-variant font-semibold">Today's Departures</span>
                    <h2 class="font-headline text-3xl font-bold text-on-surface mt-1">@ViewBag.DeparturesToday</h2>
                    <p class="text-xs text-on-surface-variant mt-0.5">Guests checking out</p>
                </div>
                <div class="w-12 h-12 rounded-xl bg-primary/10 text-primary flex items-center justify-center">
                    <span class="material-symbols-outlined text-2xl">logout</span>
                </div>
            </div>

            <div class="bg-surface-container-lowest p-6 rounded-2xl shadow-sm border border-black/5 flex items-center justify-between">
                <div>
                    <span class="text-xs uppercase tracking-wider text-primary font-semibold">Direct Desk Entry</span>
                    <h3 class="font-headline text-xl font-bold text-on-surface mt-1">Walk-in Registry</h3>
                    <p class="text-xs text-on-surface-variant mt-0.5">Register guests instantly</p>
                </div>
                <a asp-action="CreateWalkIn" class="w-12 h-12 rounded-xl bg-primary text-white flex items-center justify-center shadow-sm hover:bg-primary-container transition">
                    <span class="material-symbols-outlined text-2xl">add</span>
                </a>
            </div>
        </div>

        <!-- Search + Filter Form -->
        <div class="bg-surface-container-lowest p-6 rounded-2xl shadow-sm border border-black/5">
            <form asp-action="Index" method="get" class="grid grid-cols-1 sm:grid-cols-12 gap-4 items-center">
                <div class="sm:col-span-6">
                    <label class="block text-xs uppercase font-semibold text-on-surface-variant mb-1.5">Search Registry</label>
                    <input type="text" name="search" value="@Model.Filter.Search" class="w-full px-4 py-3 bg-surface-container-low border border-outline-variant/30 rounded-xl text-sm font-medium focus:ring-2 focus:ring-primary/20 outline-none" placeholder="Reference, guest name or email..." />
                </div>
                <div class="sm:col-span-4">
                    <label class="block text-xs uppercase font-semibold text-on-surface-variant mb-1.5">Status Filter</label>
                    <select name="statusFilter" class="w-full px-4 py-3 bg-surface-container-low border border-outline-variant/30 rounded-xl text-sm font-medium focus:ring-2 focus:ring-primary/20 outline-none">
                        <option value="">All Statuses</option>
                        <option value="Pending" selected="@(Model.Filter.StatusFilter?.ToString() == "Pending")">Pending</option>
                        <option value="Confirmed" selected="@(Model.Filter.StatusFilter?.ToString() == "Confirmed")">Confirmed</option>
                        <option value="CheckedIn" selected="@(Model.Filter.StatusFilter?.ToString() == "CheckedIn")">Checked In</option>
                        <option value="CheckedOut" selected="@(Model.Filter.StatusFilter?.ToString() == "CheckedOut")">Checked Out</option>
                        <option value="Cancelled" selected="@(Model.Filter.StatusFilter?.ToString() == "Cancelled")">Cancelled</option>
                    </select>
                </div>
                <div class="sm:col-span-2 self-end">
                    <button type="submit" class="w-full py-3 bg-primary text-white text-sm font-semibold rounded-xl hover:bg-primary-container transition shadow-md flex items-center justify-center gap-1.5">
                        <span class="material-symbols-outlined text-lg">filter_list</span> Filter
                    </button>
                </div>
            </form>
        </div>

        <!-- Bookings Table Card -->
        <div class="bg-surface-container-lowest rounded-2xl shadow-sm border border-black/5 overflow-hidden">
            <div class="px-6 py-5 border-b border-black/5 flex items-center justify-between">
                <h3 class="font-headline text-xl font-bold text-on-surface">Reservations Registry</h3>
                <span class="text-xs text-on-surface-variant">Total Records: @Model.TotalCount</span>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full min-w-[900px] text-left border-collapse">
                    <thead class="bg-surface-container-low text-[11px] uppercase tracking-wider font-semibold text-on-surface-variant border-b border-black/5">
                        <tr>
                            <th class="px-6 py-4">Booking Ref</th>
                            <th class="px-6 py-4">Guest Name</th>
                            <th class="px-6 py-4">Assigned Room</th>
                            <th class="px-6 py-4">Check-in</th>
                            <th class="px-6 py-4">Check-out</th>
                            <th class="px-6 py-4">Status</th>
                            <th class="px-6 py-4 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-black/5 text-sm">
                        @if (!Model.Bookings.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center text-on-surface-variant py-12">No bookings matching your criteria found.</td>
                            </tr>
                        }
                        @foreach (var b in Model.Bookings)
                        {
                            <tr class="hover:bg-surface-container-low/50 transition">
                                <td class="px-6 py-4 font-semibold text-primary">@b.BookingReference</td>
                                <td class="px-6 py-4 font-medium text-on-surface">@b.Guest.FirstName @b.Guest.LastName</td>
                                <td class="px-6 py-4 text-on-surface-variant">@b.Room.RoomType.Name (No. @b.Room.RoomNumber)</td>
                                <td class="px-6 py-4 text-on-surface-variant">@b.CheckInDate.ToString("MMM dd, yyyy")</td>
                                <td class="px-6 py-4 text-on-surface-variant">@b.CheckOutDate.ToString("MMM dd, yyyy")</td>
                                <td class="px-6 py-4">
                                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold 
                                        @(b.Status == Hotel_MVC.Enums.BookingStatus.Confirmed ? "bg-emerald-100 text-emerald-800" : 
                                          b.Status == Hotel_MVC.Enums.BookingStatus.CheckedIn ? "bg-blue-100 text-blue-800" : 
                                          b.Status == Hotel_MVC.Enums.BookingStatus.CheckedOut ? "bg-zinc-100 text-zinc-800" : "bg-amber-100 text-amber-800")">
                                        @b.Status
                                    </span>
                                </td>
                                <td class="px-6 py-4 text-right space-x-2">
                                    @if (b.Status == Hotel_MVC.Enums.BookingStatus.Pending)
                                    {
                                        <form asp-action="Confirm" asp-route-id="@b.Id" method="post" class="inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="px-3 py-1.5 bg-primary text-white text-xs font-semibold rounded-lg hover:bg-primary-container transition">Confirm</button>
                                        </form>
                                    }
                                    @if (b.Status == Hotel_MVC.Enums.BookingStatus.Confirmed)
                                    {
                                        <form asp-action="CheckIn" asp-route-id="@b.Id" method="post" class="inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="px-3 py-1.5 bg-emerald-700 text-white text-xs font-semibold rounded-lg hover:bg-emerald-800 transition">Check In</button>
                                        </form>
                                    }
                                    @if (b.Status == Hotel_MVC.Enums.BookingStatus.CheckedIn)
                                    {
                                        <form asp-action="CheckOut" asp-route-id="@b.Id" method="post" class="inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="px-3 py-1.5 bg-zinc-800 text-white text-xs font-semibold rounded-lg hover:bg-black transition">Check Out</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            @if (Model.TotalPages > 1)
            {
                <div class="px-6 py-4 border-t border-black/5 flex items-center justify-center gap-1">
                    @for (int p = 1; p <= Model.TotalPages; p++)
                    {
                        <a class="px-3.5 py-1.5 rounded-lg text-xs font-semibold transition @(p == Model.Filter.Page ? "bg-primary text-white" : "bg-surface-container-low text-on-surface hover:bg-surface-container-high")"
                           asp-action="Index"
                           asp-route-search="@Model.Filter.Search"
                           asp-route-statusFilter="@Model.Filter.StatusFilter"
                           asp-route-page="@p">@p</a>
                    }
                </div>
            }
        </div>

    </div>
</div>
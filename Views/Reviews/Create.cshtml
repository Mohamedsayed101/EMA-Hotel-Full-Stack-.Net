@model Hotel_MVC.Models.Review
@{
    ViewData["Title"] = "Write a Review";
}

<div class="w-full bg-surface min-h-screen py-10">
    <div class="max-w-xl mx-auto px-6">

        <div class="mb-6 flex items-center justify-between">
            <div>
                <span class="text-primary font-semibold text-xs uppercase tracking-widest">Guest Feedback</span>
                <h1 class="font-headline text-3xl font-bold text-on-surface mt-1">Rate Your Sanctuary Experience</h1>
            </div>
            <a asp-controller="Booking" asp-action="MyBookings" class="px-4 py-2 bg-surface-container text-on-surface text-xs font-semibold rounded-lg hover:bg-surface-container-high transition">
                Back to Bookings
            </a>
        </div>

        @if (TempData["Error"] != null)
        {
            <div class="mb-6 p-4 rounded-xl bg-red-50 border border-red-200 text-red-700 text-sm">
                @TempData["Error"]
            </div>
        }

        <div class="bg-surface-container-lowest rounded-2xl p-8 shadow-sm border border-black/5">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="bookingId" value="@(ViewBag.BookingId ?? Context.Request.Query["bookingId"])" />

                <div class="space-y-6">
                    <div>
                        <label for="rating" class="block text-xs uppercase font-semibold text-on-surface-variant mb-2">Rating (1 to 5 Stars)</label>
                        <select name="rating" id="rating" class="w-full px-4 py-3 bg-surface-container-low border border-outline-variant/30 rounded-xl text-sm font-medium focus:ring-2 focus:ring-primary/20 outline-none">
                            <option value="5">★★★★★ - Exceptional (5/5)</option>
                            <option value="4">★★★★☆ - Very Good (4/5)</option>
                            <option value="3">★★★☆☆ - Average (3/5)</option>
                            <option value="2">★★☆☆☆ - Below Expectations (2/5)</option>
                            <option value="1">★☆☆☆☆ - Poor (1/5)</option>
                        </select>
                    </div>

                    <div>
                        <label for="comment" class="block text-xs uppercase font-semibold text-on-surface-variant mb-2">Your Comments &amp; Review</label>
                        <textarea name="comment" id="comment" rows="5" class="w-full px-4 py-3 bg-surface-container-low border border-outline-variant/30 rounded-xl text-sm font-medium focus:ring-2 focus:ring-primary/20 outline-none" placeholder="Tell us about the ambiance, service, and comfort..." required></textarea>
                    </div>

                    <div class="flex items-center justify-end gap-3">
                        <a asp-controller="Booking" asp-action="MyBookings" class="px-5 py-2.5 bg-surface-container text-on-surface text-sm font-semibold rounded-xl hover:bg-surface-container-high transition">Cancel</a>
                        <button type="submit" class="px-6 py-2.5 bg-primary text-white text-sm font-semibold rounded-xl hover:bg-primary-container transition shadow-md">Submit Review</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
@model Hotel_MVC.Models.Booking
@{
    ViewData["Title"] = $"Complete Payment - {Model.BookingReference}";
    var nights = (Model.CheckOutDate - Model.CheckInDate).Days;
}

<div class="w-full bg-surface min-h-screen py-16">
    <div class="max-w-4xl mx-auto px-6">

        <div class="text-center mb-10">
            <span class="text-primary font-semibold text-xs uppercase tracking-widest">Sanctuary Checkout</span>
            <h1 class="font-headline text-3xl sm:text-4xl text-on-surface font-bold mt-1">Secure Reservation Payment</h1>
            <p class="text-sm text-on-surface-variant mt-1">Booking Ref: <strong>@Model.BookingReference</strong></p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
            <!-- Payment Form -->
            <div class="md:col-span-7 bg-surface-container-lowest p-8 rounded-2xl shadow-sm border border-black/5">
                <h3 class="font-headline text-xl font-semibold text-on-surface mb-6 flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary">credit_card</span> Credit / Debit Card
                </h3>

                <form asp-controller="Booking" asp-action="ProcessPayment" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="bookingId" value="@Model.Id" />

                    <div class="space-y-4">
                        <div>
                            <label class="block text-xs uppercase font-semibold text-on-surface-variant mb-1.5">Cardholder Name</label>
                            <input type="text" class="w-full px-4 py-3 rounded-xl bg-surface-container-low border border-outline-variant/30 text-sm font-medium focus:ring-2 focus:ring-primary/20 outline-none" required placeholder="Full Name on Card" />
                        </div>

                        <div>
                            <label class="block text-xs uppercase font-semibold text-on-surface-variant mb-1.5">Card Number</label>
                            <input type="text" maxlength="19" class="w-full px-4 py-3 rounded-xl bg-surface-container-low border border-outline-variant/30 text-sm font-medium focus:ring-2 focus:ring-primary/20 outline-none" required placeholder="•••• •••• •••• ••••" />
                        </div>

                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label class="block text-xs uppercase font-semibold text-on-surface-variant mb-1.5">Expiration (MM/YY)</label>
                                <input type="text" maxlength="5" class="w-full px-4 py-3 rounded-xl bg-surface-container-low border border-outline-variant/30 text-sm font-medium focus:ring-2 focus:ring-primary/20 outline-none" required placeholder="12/28" />
                            </div>
                            <div>
                                <label class="block text-xs uppercase font-semibold text-on-surface-variant mb-1.5">Security Code (CVV)</label>
                                <input type="password" maxlength="4" class="w-full px-4 py-3 rounded-xl bg-surface-container-low border border-outline-variant/30 text-sm font-medium focus:ring-2 focus:ring-primary/20 outline-none" required placeholder="•••" />
                            </div>
                        </div>

                        <button type="submit" class="w-full mt-6 py-4 bg-primary text-white font-semibold rounded-xl text-sm hover:bg-primary-container transition shadow-md flex items-center justify-center gap-2">
                            <span class="material-symbols-outlined text-lg">lock</span> Pay @Model.TotalAmount.ToString("N0") EGP &amp; Guarantee Stay
                        </button>
                    </div>
                </form>
            </div>

            <!-- Booking Overview Sidebar -->
            <div class="md:col-span-5 bg-surface-container-low p-7 rounded-2xl border border-black/5 flex flex-col justify-between">
                <div>
                    <h3 class="font-headline text-lg font-bold text-on-surface mb-4">Reservation Details</h3>
                    <div class="space-y-3 text-sm text-on-surface-variant">
                        <div class="flex justify-between">
                            <span>Suite Type:</span>
                            <strong class="text-on-surface font-medium">@Model.Room.RoomType.Name</strong>
                        </div>
                        <div class="flex justify-between">
                            <span>Assigned Room:</span>
                            <strong class="text-on-surface font-medium">Room @Model.Room.RoomNumber</strong>
                        </div>
                        <div class="flex justify-between">
                            <span>Stay Duration:</span>
                            <span>@nights Night(s)</span>
                        </div>
                        <div class="flex justify-between">
                            <span>Check-in:</span>
                            <span>@Model.CheckInDate.ToString("MMM dd, yyyy")</span>
                        </div>
                        <div class="flex justify-between">
                            <span>Check-out:</span>
                            <span>@Model.CheckOutDate.ToString("MMM dd, yyyy")</span>
                        </div>
                    </div>
                </div>

                <div class="pt-6 border-t border-outline-variant/20 mt-6">
                    <div class="flex justify-between items-baseline">
                        <span class="text-xs uppercase tracking-wider font-semibold text-on-surface-variant">Grand Total:</span>
                        <div class="text-right">
                            <span class="font-headline text-3xl font-bold text-primary">@Model.TotalAmount.ToString("N0")</span>
                            <span class="text-xs text-on-surface-variant">EGP</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>
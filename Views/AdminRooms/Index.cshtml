@model IEnumerable<Hotel_MVC.Models.Room>

@{
    ViewData["Title"] = "Manage Rooms";

    int currentPage = ViewBag.Page ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;

    string? search = ViewBag.Search;
    string? status = ViewBag.Status?.ToString();
    string? sort = ViewBag.Sort;
}

<div class="w-full bg-surface min-h-screen py-10">
    <div class="max-w-[1320px] mx-auto px-6 lg:px-12 space-y-8">

        <!-- Page Header -->
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
            <div>
                <span class="text-primary font-semibold text-xs uppercase tracking-widest">
                    Admin Registry
                </span>

                <h1 class="font-headline text-3xl sm:text-4xl font-bold text-on-surface mt-1">
                    Rooms Management
                </h1>

                <p class="text-sm text-on-surface-variant mt-1">
                    Monitor room units, physical floor levels, and operational statuses.
                </p>
            </div>

            <div>
                <a asp-action="Create"
                   class="px-6 py-3 bg-primary text-white text-sm font-semibold rounded-xl hover:bg-primary-container transition shadow-md flex items-center gap-2">
                    <span class="material-symbols-outlined text-lg">
                        meeting_room
                    </span>

                    Add New Room
                </a>
            </div>
        </div>


        <!-- Alerts -->
        @if (TempData["Success"] != null)
        {
            <div class="p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm flex items-center gap-2">

                <span class="material-symbols-outlined text-lg">
                    check_circle
                </span>

                <span>
                    @TempData["Success"]
                </span>

            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="p-4 rounded-xl bg-red-50 border border-red-200 text-red-700 text-sm flex items-center gap-2">

                <span class="material-symbols-outlined text-lg">
                    error
                </span>

                <span>
                    @TempData["Error"]
                </span>

            </div>
        }


        <!-- Rooms Table Card -->

        <div class="bg-surface-container-lowest rounded-2xl shadow-sm border border-black/5 overflow-hidden">

            <!-- Card Header -->

            <div class="px-6 py-5 border-b border-black/5 flex items-center justify-between">

                <h3 class="font-headline text-xl font-bold text-on-surface">
                    Physical Rooms Registry
                </h3>

                <span class="text-xs text-on-surface-variant">
                    Total Units: @Model.Count()
                </span>

            </div>


            <!-- Table -->

            <div class="overflow-x-auto">

                <table class="w-full min-w-[800px] text-left border-collapse">

                    <thead class="bg-surface-container-low text-[11px] uppercase tracking-wider font-semibold text-on-surface-variant border-b border-black/5">

                        <tr>

                            <th class="px-6 py-4">
                                Room Number
                            </th>

                            <th class="px-6 py-4">
                                Sanctuary Type
                            </th>

                            <th class="px-6 py-4">
                                Floor Level
                            </th>

                            <th class="px-6 py-4">
                                Status
                            </th>

                            <th class="px-6 py-4 text-right">
                                Actions
                            </th>

                        </tr>

                    </thead>


                    <tbody class="divide-y divide-black/5 text-sm">

                        @if (!Model.Any())
                        {
                            <tr>

                                <td colspan="5"
                                    class="text-center text-on-surface-variant py-12">

                                    No rooms registered yet.

                                </td>

                            </tr>
                        }
                        else
                        {
                            @foreach (var room in Model)
                            {
                                <tr class="hover:bg-surface-container-low/50 transition">

                                    <!-- Room Number -->

                                    <td class="px-6 py-4 font-semibold text-primary">
                                        No. @room.RoomNumber
                                    </td>


                                    <!-- Room Type -->

                                    <td class="px-6 py-4 font-medium text-on-surface">
                                        @room.RoomType?.Name
                                    </td>


                                    <!-- Floor -->

                                    <td class="px-6 py-4 text-on-surface-variant">
                                        Floor @room.FloorNumber
                                    </td>


                                    <!-- Status -->

                                    <td class="px-6 py-4">

                                        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold
                                            @(room.Status == Hotel_MVC.Enums.RoomStatus.Available
                                                ? "bg-emerald-100 text-emerald-800"
                                                : room.Status == Hotel_MVC.Enums.RoomStatus.OutOfService
                                                    ? "bg-blue-100 text-blue-800"
                                                    : "bg-amber-100 text-amber-800")">

                                            @room.Status

                                        </span>

                                    </td>


                                    <!-- Actions -->

                                    <td class="px-6 py-4 text-right space-x-2">

                                        <a asp-action="Edit"
                                           asp-route-id="@room.Id"
                                           class="px-3 py-1.5 bg-surface-container text-on-surface text-xs font-semibold rounded-lg hover:bg-surface-container-high transition">

                                            Edit

                                        </a>


                                        <a asp-action="Delete"
                                           asp-route-id="@room.Id"
                                           class="px-3 py-1.5 bg-red-100 text-red-700 text-xs font-semibold rounded-lg hover:bg-red-200 transition">

                                            Delete

                                        </a>

                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>

        </div>


        <!-- Pagination -->
        @if (totalPages > 1)
        {
            <div class="flex flex-wrap items-center justify-center gap-2 pt-2">

                <!-- Previous -->
                @if (currentPage > 1)
                {
                    <a asp-action="Index"
                       asp-route-page="@(currentPage - 1)"
                       asp-route-search="@search"
                       asp-route-status="@status"
                       asp-route-sort="@sort"
                       class="px-4 py-2 rounded-lg bg-surface-container text-on-surface text-sm font-semibold hover:bg-surface-container-high transition">

                        Previous

                    </a>
                }


                <!-- Page Numbers -->
                @for (int i = 1; i <= totalPages; i++)
                {
                    <a asp-action="Index"
                       asp-route-page="@i"
                       asp-route-search="@search"
                       asp-route-status="@status"
                       asp-route-sort="@sort"
                       class="px-3 py-2 rounded-lg text-sm font-semibold
                        @(i == currentPage
                           ? "bg-primary text-white"
                           : "bg-surface-container text-on-surface hover:bg-surface-container-high")">

                        @i

                    </a>
                }


                <!-- Next -->
                @if (currentPage < totalPages)
                {
                    <a asp-action="Index"
                       asp-route-page="@(currentPage + 1)"
                       asp-route-search="@search"
                       asp-route-status="@status"
                       asp-route-sort="@sort"
                       class="px-4 py-2 rounded-lg bg-surface-container text-on-surface text-sm font-semibold hover:bg-surface-container-high transition">

                        Next

                    </a>
                }

            </div>
        }

    </div>
</div>
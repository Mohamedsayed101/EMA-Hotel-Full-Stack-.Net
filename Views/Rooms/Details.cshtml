@model Hotel_MVC.Models.RoomType
@{
    ViewData["Title"] = Model.Name + " - Details";

    // تجميع كل التقييمات الخاصة بكل الغرف التابعة لهذا النوع
    var allReviews = Model.Rooms?
        .SelectMany(r => r.Bookings)
        .Where(b => b.Review != null)
        .Select(b => b.Review!)
        .ToList() ?? new List<Hotel_MVC.Models.Review>();

    double avgRating = allReviews.Any() ? allReviews.Average(r => r.Rating) : 0;
    int totalReviews = allReviews.Count();

    // صور الغرفة
    var images = Model.RoomImages?.OrderBy(i => i.DisplayOrder).ToList() ?? new List<Hotel_MVC.Models.RoomImage>();
    var coverImage = images.FirstOrDefault()?.ImageUrl ?? "/images/default-room.jpg";
    var secondaryImages = images.Skip(1).Take(3).ToList();
}

<div class="w-full bg-surface min-h-screen py-10">
    <div class="max-w-[1200px] mx-auto px-6 space-y-8">

        <!-- Back Button -->
        <div>
            <a asp-action="Index" class="inline-flex items-center gap-2 px-4 py-2 bg-surface-container text-on-surface text-xs font-semibold rounded-xl hover:bg-surface-container-high transition">
                <span class="material-symbols-outlined text-sm">arrow_back</span> Back to Rooms
            </a>
        </div>

        <!-- 1. الصور: صورة أساسية كبيرة وجانبها صور مصغرة -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-4">
            <!-- الصورة الرئيسية الكبيرة -->
            <div class="lg:col-span-8 h-[400px] sm:h-[450px] rounded-3xl overflow-hidden shadow-sm bg-surface-container-low relative">
                <img src="@coverImage" alt="@Model.Name" class="w-full h-full object-cover" id="mainImage" />
                <div class="absolute top-4 left-4">
                    <span class="px-3.5 py-1.5 rounded-full text-xs font-bold bg-black/60 text-white backdrop-blur-md">
                        @(Model.ViewType ?? "City") View
                    </span>
                </div>
            </div>

            <!-- الصور المصغرة بجانبها -->
            <div class="lg:col-span-4 flex lg:flex-col gap-4 overflow-x-auto lg:overflow-visible">
                @if (secondaryImages.Any())
                {
                    @foreach (var img in secondaryImages)
                    {
                        <div class="w-1/3 lg:w-full h-[126px] sm:h-[140px] rounded-2xl overflow-hidden shadow-sm bg-surface-container-low cursor-pointer flex-shrink-0 border border-black/5 hover:opacity-90 transition">
                            <img src="@img.ImageUrl" alt="Room thumbnail" class="w-full h-full object-cover thumb-img" onclick="document.getElementById('mainImage').src=this.src" />
                        </div>
                    }
                }
                else
                {
                    <div class="w-full h-full min-h-[140px] rounded-2xl bg-surface-container-low flex items-center justify-center text-xs text-on-surface-variant border border-black/5">
                        No additional photos
                    </div>
                }
            </div>
        </div>

        <!-- 2. تحت الصور: تفاصيل الغرفة، السعر، التقييم، وزر الحجز -->
        <div class="bg-surface-container-lowest p-8 rounded-3xl shadow-sm border border-black/5 flex flex-col md:flex-row md:items-center justify-between gap-6">
            <div class="space-y-3 max-w-2xl">
                <div class="flex items-center gap-3">
                    <span class="text-primary font-semibold text-xs uppercase tracking-widest">Sanctuary Details</span>
                    <!-- Rating Badge -->
                    <div class="flex items-center gap-1.5 bg-surface-container-low px-3 py-1 rounded-xl border border-black/5">
                        <span class="material-symbols-outlined text-amber-500 fill-current text-sm">star</span>
                        <span class="font-bold text-on-surface text-sm">@(avgRating > 0 ? avgRating.ToString("0.1") : "New")</span>
                        <span class="text-[11px] text-on-surface-variant">(@totalReviews reviews)</span>
                    </div>
                </div>

                <h1 class="font-headline text-3xl sm:text-4xl font-bold text-on-surface">@Model.Name</h1>
                <p class="text-sm text-on-surface-variant leading-relaxed">@Model.Description</p>

                @if (!string.IsNullOrEmpty(Model.Amenities))
                {
                    <p class="text-xs text-on-surface font-medium pt-1"><strong class="text-on-surface-variant uppercase text-[11px]">Amenities:</strong> @Model.Amenities</p>
                }
            </div>

            <div class="flex flex-col items-start md:items-end gap-4 min-w-[200px]">
                <div class="text-left md:text-right">
                    <span class="text-3xl font-bold text-primary">@Model.PricePerNight.ToString("N0") EGP</span>
                    <span class="text-xs text-on-surface-variant block">Per Night</span>
                </div>
                <a asp-controller="Booking" asp-action="Create" asp-route-roomTypeId="@Model.Id" class="w-full md:w-auto px-6 py-3 bg-primary text-white text-xs font-semibold rounded-xl hover:bg-primary-container transition shadow-md text-center">
                    Book This Sanctuary
                </a>
            </div>
        </div>

        <!-- 3. قسم تقييمات النزلاء (Reviews & Feedback) بدون جملة Verified Guest -->
        <div class="bg-surface-container-lowest p-8 rounded-3xl shadow-sm border border-black/5 space-y-6">
            <h3 class="font-headline text-xl font-bold text-on-surface">Guest Reviews &amp; Feedback</h3>

            @if (!allReviews.Any())
            {
                <div class="text-center py-8 space-y-2">
                    <span class="material-symbols-outlined text-4xl text-on-surface-variant/40">rate_review</span>
                    <p class="text-sm text-on-surface-variant">No reviews yet for this room type. Be the first to review after your stay!</p>
                </div>
            }
            else
            {
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    @foreach (var review in allReviews)
                    {
                        <div class="p-6 rounded-2xl bg-surface-container-low/60 border border-black/5 space-y-3">
                            <div class="flex items-center justify-between">
                                <div class="flex items-center gap-1 text-amber-500">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        if (i <= review.Rating)
                                        {
                                            <span class="material-symbols-outlined text-base fill-current">star</span>
                                        }
                                        else
                                        {
                                            <span class="material-symbols-outlined text-base text-gray-300">star</span>
                                        }
                                    }
                                </div>
                               
                            </div>
                            <p class="text-sm text-on-surface italic leading-relaxed">"@review.Comment"</p>
                        </div>
                    }
                </div>
            }
        </div>

    </div>
</div>
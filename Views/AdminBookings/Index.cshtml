@using Hotel_MVC.Enums
@model Hotel_MVC.ViewModels.Admin.BookingAdminListVM
@{
    ViewData["Title"] = "Bookings Ledger";
}

<div class="w-full bg-surface min-h-screen py-10">
    <div class="max-w-[1320px] mx-auto px-6 lg:px-12 space-y-8">

        <!-- Page Header -->
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
            <div>
                <span class="text-primary font-semibold text-xs uppercase tracking-widest">Administrative Ledger</span>
                <h1 class="font-headline text-3xl sm:text-4xl font-bold text-on-surface mt-1">Bookings Management</h1>
                <p class="text-sm text-on-surface-variant mt-1">Search, filter, and audit all hotel reservations across the platform.</p>
            </div>
            <div>
                <a asp-controller="AdminDashboard" asp-action="Index" class="px-4 py-2 bg-surface-container text-on-surface text-xs font-semibold rounded-lg hover:bg-surface-container-high transition">
                    Back to Dashboard
                </a>
            </div>
        </div>

        <!-- Search + Filter Form Card -->
        <div class="bg-surface-container-lowest p-6 rounded-2xl shadow-sm border border-black/5">
            <form method="get" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4 items-end">
                <div>
                    <label class="block text-xs uppercase font-semibold text-on-surface-variant mb-1.5">Search Guest / Ref</label>
                    <input asp-for="Search" class="w-full px-4 py-3 bg-surface-container-low border border-outline-variant/30 rounded-xl text-sm font-medium focus:ring-2 focus:ring-primary/20 outline-none" placeholder="Reference, guest or email..." />
                </div>
                <div>
                    <label class="block text-xs uppercase font-semibold text-on-surface-variant mb-1.5">Status Filter</label>
                    <select asp-for="Status" class="w-full px-4 py-3 bg-surface-container-low border border-outline-variant/30 rounded-xl text-sm font-medium focus:ring-2 focus:ring-primary/20 outline-none">
                        <option value="">All Statuses</option>
                        @foreach (var s in Enum.GetValues<BookingStatus>())
                        {
                            <option value="@s">@s</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="block text-xs uppercase font-semibold text-on-surface-variant mb-1.5">Date Filter</label>
                    <input asp-for="Date" type="date" class="w-full px-4 py-3 bg-surface-container-low border border-outline-variant/30 rounded-xl text-sm font-medium focus:ring-2 focus:ring-primary/20 outline-none" />
                </div>
                <div>
                    <label class="block text-xs uppercase font-semibold text-on-surface-variant mb-1.5">Sort Order</label>
                    <select name="sort" class="w-full px-4 py-3 bg-surface-container-low border border-outline-variant/30 rounded-xl text-sm font-medium focus:ring-2 focus:ring-primary/20 outline-none">
                        <option value="">Newest First</option>
                        <option value="date" selected="@(ViewBag.Sort == "date")">Check-in Date</option>
                        <option value="total_desc" selected="@(ViewBag.Sort == "total_desc")">Highest Total</option>
                        <option value="guest" selected="@(ViewBag.Sort == "guest")">Guest Name</option>
                    </select>
                </div>
                <div>
                    <button type="submit" class="w-full py-3 bg-primary text-white text-sm font-semibold rounded-xl hover:bg-primary-container transition shadow-md flex items-center justify-center gap-1.5">
                        <span class="material-symbols-outlined text-lg">filter_list</span> Apply Filters
                    </button>
                </div>
            </form>
        </div>

        <!-- Bookings Table Card -->
        <div class="bg-surface-container-lowest rounded-2xl shadow-sm border border-black/5 overflow-hidden">
            <div class="px-6 py-5 border-b border-black/5 flex items-center justify-between">
                <h3 class="font-headline text-xl font-bold text-on-surface">Reservations Ledger</h3>
                <span class="text-xs text-on-surface-variant">Total Bookings: @Model.TotalCount</span>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full min-w-[950px] text-left border-collapse">
                    <thead class="bg-surface-container-low text-[11px] uppercase tracking-wider font-semibold text-on-surface-variant border-b border-black/5">
                        <tr>
                            <th class="px-6 py-4">Reference</th>
                            <th class="px-6 py-4">Guest Info</th>
                            <th class="px-6 py-4">Assigned Room</th>
                            <th class="px-6 py-4">Stay Dates</th>
                            <th class="px-6 py-4">Total Amount</th>
                            <th class="px-6 py-4">Status</th>
                            <th class="px-6 py-4 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-black/5 text-sm">
                        @if (!Model.Bookings.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center text-on-surface-variant py-12">No bookings found matching your criteria.</td>
                            </tr>
                        }
                        @foreach (var b in Model.Bookings)
                        {
                            <tr class="hover:bg-surface-container-low/50 transition">
                                <td class="px-6 py-4 font-semibold text-primary">@b.BookingReference</td>
                                <td class="px-6 py-4">
                                    <p class="font-medium text-on-surface">@b.Guest.FirstName @b.Guest.LastName</p>
                                    <p class="text-xs text-on-surface-variant">@b.Guest.Email</p>
                                </td>
                                <td class="px-6 py-4 text-on-surface-variant">
                                    @b.Room.RoomNumber · @b.Room.RoomType.Name
                                </td>
                                <td class="px-6 py-4 text-xs text-on-surface-variant">
                                    @b.CheckInDate.ToString("dd MMM yyyy") <br />to @b.CheckOutDate.ToString("dd MMM yyyy")
                                </td>
                                <td class="px-6 py-4 font-semibold text-on-surface">
                                    @b.TotalAmount.ToString("N0") EGP
                                </td>
                                <td class="px-6 py-4">
                                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold 
                                        @(b.Status.ToString() == "Confirmed" ? "bg-emerald-100 text-emerald-800" : 
                                          b.Status.ToString() == "CheckedIn" ? "bg-blue-100 text-blue-800" : 
                                          b.Status.ToString() == "CheckedOut" ? "bg-zinc-100 text-zinc-800" : "bg-amber-100 text-amber-800")">
                                        @b.Status
                                    </span>
                                </td>
                                <td class="px-6 py-4 text-right space-x-2">
                                    <a asp-action="Details" asp-route-id="@b.Id" class="px-3 py-1.5 bg-surface-container text-on-surface text-xs font-semibold rounded-lg hover:bg-surface-container-high transition">Details</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            @if (Model.TotalPages > 1)
            {
                <div class="px-6 py-4 border-t border-black/5 flex items-center justify-center gap-1">
                    @for (int p = 1; p <= Model.TotalPages; p++)
                    {
                        <a class="px-3.5 py-1.5 rounded-lg text-xs font-semibold transition @(p == Model.Page ? "bg-primary text-white" : "bg-surface-container-low text-on-surface hover:bg-surface-container-high")"
                           asp-action="Index"
                           asp-route-page="@p"
                           asp-route-search="@Model.Search"
                           asp-route-status="@Model.Status"
                           asp-route-date="@Model.Date?.ToString("yyyy-MM-dd")"
                           asp-route-sort="@ViewBag.Sort">@p</a>
                    }
                </div>
            }
        </div>

    </div>
</div>
@using Microsoft.AspNetCore.Identity
@inject SignInManager<Hotel_MVC.Models.ApplicationUser> SignInManager
@inject UserManager<Hotel_MVC.Models.ApplicationUser> UserManager
<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EMA Hotel &amp; Suites</title>
    <!-- Tailwind CSS & Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..700;1,400..700&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#79551e',
                        'primary-container': '#946d35',
                        surface: '#fff8f5',
                        'surface-container-low': '#fcedeb',
                        'surface-container-lowest': '#ffffff',
                        'on-surface': '#201a15',
                        'on-surface-variant': '#524438'
                    },
                    fontFamily: {
                        headline: ['Playfair Display', 'serif'],
                        body: ['Plus Jakarta Sans', 'sans-serif']
                    }
                }
            }
        }
    </script>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="h-full font-body bg-surface text-on-surface antialiased flex flex-col justify-between selection:bg-primary/20">

    <!-- Header / Navbar -->
    <header class="sticky top-0 z-50 w-full bg-surface/90 backdrop-blur-md border-b border-black/5">
        <div class="max-w-[1320px] mx-auto px-6 lg:px-12 h-20 flex items-center justify-between">
            <a asp-controller="Home" asp-action="Index" class="flex items-center gap-2">
                <span class="material-symbols-outlined text-primary text-3xl">hotel_class</span>
                <span class="font-headline text-2xl font-bold tracking-tight text-on-surface">EMA Hotel</span>
            </a>

            <div class="hidden md:flex items-center gap-8 text-sm font-medium text-on-surface-variant">
                <!-- 1. الروابط التي تظهر للجميع (سواء مسجل دخول أو لأ) -->
                <a asp-controller="Home" asp-action="Index" class="hover:text-primary transition">Home</a>
                <a asp-controller="Home" asp-action="About" class="hover:text-primary transition">
                    About
                </a>
                <a asp-controller="Rooms" asp-action="Index" class="hover:text-primary transition">Rooms &amp; Suites</a>
                
                <!-- AI Concierge Link (Publicly Accessible) -->
                <a asp-controller="Concierge" asp-action="Index" class="inline-flex items-center gap-1.5 text-primary font-semibold hover:opacity-80 transition">
                    <span class="material-symbols-outlined text-base">smart_toy</span>
                    <span>AI Concierge</span>
                </a>

                <!-- 2. الروابط التي تظهر فقط للمستخدم العادي المسجل دخول (Guest) وليست للأدمن أو الريسبشن -->
                @if (User.Identity.IsAuthenticated && !User.IsInRole("Admin") && !User.IsInRole("Receptionist"))
                {
                    <a asp-controller="Booking" asp-action="MyBookings" class="hover:text-primary transition">My Bookings</a>
                    <a asp-controller="Account" asp-action="Profile" class="hover:text-primary transition">My Profile</a>
                }

                <!-- 3. روابط خاصة بالأدمن (Admin Links) -->
                @if (User.IsInRole("Admin"))
                {
                    <a asp-controller="AdminDashboard" asp-action="Index" class="text-primary font-semibold hover:underline">Admin Dashboard</a>
                    <a asp-controller="AdminRooms" asp-action="Index" class="hover:text-primary transition">Manage Rooms</a>
                    <a asp-controller="AdminRoomTypes" asp-action="Index" class="hover:text-primary transition">Room Types</a>
                    <a asp-controller="AdminExtras" asp-action="Index" class="hover:text-primary transition">Extras</a>
                    <a asp-controller="AdminBookings" asp-action="Index" class="hover:text-primary transition">All Bookings</a>
                }

                <!-- 4. روابط خاصة بموظف الاستقبال (Receptionist Links) -->
                @if (User.IsInRole("Receptionist"))
                {
                    <a asp-controller="Receptionist" asp-action="Index" class="text-primary font-semibold hover:underline">Reception Desk</a>
                }
            </div>

            <div class="flex items-center gap-4">
                @if (SignInManager.IsSignedIn(User))
                {
                    <form asp-controller="Account" asp-action="Logout" method="post" class="inline">
                        <button type="submit" class="px-5 py-2.5 bg-surface-container-low text-on-surface text-xs font-semibold rounded-xl hover:bg-surface-container-high transition">Sign Out</button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="px-6 py-2.5 bg-primary text-white text-xs font-semibold rounded-xl hover:bg-primary-container transition shadow-sm">Sign In</a>
                }
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="flex-grow">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="w-full bg-surface-container-low border-t border-black/5 py-12">
        <div class="max-w-[1320px] mx-auto px-6 lg:px-12 flex flex-col sm:flex-row items-center justify-between gap-6 text-xs text-on-surface-variant">
            <p>&copy; @DateTime.Now.Year EMA Luxury Sanctuary &amp; Suites. All rights reserved.</p>
            <div class="flex items-center gap-6">
                <a asp-controller="Home" asp-action="Index" class="hover:text-primary transition">Privacy Policy</a>
                <a asp-controller="Concierge" asp-action="Index" class="hover:text-primary transition">Concierge Support</a>
            </div>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>